/* ═══ MOBILE COVERFLOW (bluorng-style) ════════════════════════════════
   Exact replica of bluorng.com's mobile category carousel. Every
   difference between an "inferior" slide-and-fade and their smooth,
   magazine-cover feel comes down to four stacked effects:

     (1) A deeper peek on both sides — their active tile only takes
         about 74vw, with 13vw of each neighbour visible past the edge.
         That peek is what tells the eye "there is more, swipe me".

     (2) The non-active neighbours are SMALLER (scale 0.88), not just
         dimmer. Scaling down drops them visually behind the active
         tile and pulls the eye back to the centre.

     (3) The non-active neighbours are DARKER (brightness 0.55 via a
         filter, plus opacity 0.65) — "darker" reads differently from
         "faded", which is what plain opacity gives; the filter keeps
         colour, just drops the exposure.

     (4) A long 0.42s cubic-bezier transition on both scale and opacity
         so the cover change feels like a focused camera, not a
         snap-flash. Matching the drag-translate's own 0.1s makes the
         drag feel responsive while the state-change stays silky.

   mobile only — desktop is a plain horizontal scroller (see the
   @media (min-width: 768px) block further down). ═════════════════════ */
.jnc-crosssell-track-wrap {
  overflow: hidden;
  position: relative;
  padding: 0 13vw;
  /* perspective lets any future rotateY read as 3D rather than flat
     scaling, without affecting the current transforms. */
  perspective: 1200px;
}
.jnc-crosssell-tiles {
  display: flex;
  flex-wrap: nowrap;
  gap: 10px;
  touch-action: pan-y;
  transition: transform 0.1s ease-out;
  will-change: transform;
  transform-style: preserve-3d;
}
.jnc-crosssell-tile {
  flex: 0 0 74vw;
  min-width: 0;
  text-decoration: none;
  display: block;
  cursor: pointer;
  transform-origin: center center;
}

/* ═══ MOBILE COVERFLOW effects ─ scoped to phone widths only ═════════════════
   Desktop tiles never get the scale / opacity / filter changes below.
   Desktop uses the 4-tile grid in the @media (min-width: 768px) block
   below this one; applying the mobile dim/shrink to tiles there would
   grey them out and resize them unpredictably. Same transition is
   defined here so it only costs anything on mobile. */
@media (max-width: 767px) {
  .jnc-crosssell-tile {
    transition: opacity 0.42s cubic-bezier(.22,.61,.36,1),
                transform 0.42s cubic-bezier(.22,.61,.36,1),
                filter 0.42s cubic-bezier(.22,.61,.36,1);
  }
  .jnc-crosssell-tile:not(.jnc-cs-active) {
    opacity: 0.7;
    transform: scale(0.9);
    filter: brightness(0.65);
  }
  .jnc-crosssell-tile.jnc-cs-active {
    opacity: 1;
    transform: scale(1);
    filter: none;
  }
  /* Extra-mile 3D coverflow tilt — the IMMEDIATE neighbours of the
     active tile rotate inward (left tile's right edge forward, right
     tile's left edge forward) so the row reads as a curved rack of
     covers rather than a flat strip. JS adds jnc-cs-left to the tile
     immediately before active, jnc-cs-right to the one immediately
     after; tiles further out stay at the plain scale+dim without the
     tilt so the effect doesn't compound into a mess. transform-origin
     moved to the edge nearest the active tile so the rotation hinges
     where the eye expects the pivot — same trick a real coverflow
     uses. perspective is already on .jnc-crosssell-track-wrap. */
  .jnc-crosssell-tile.jnc-cs-left {
    transform: scale(0.9) rotateY(14deg);
    transform-origin: right center;
  }
  .jnc-crosssell-tile.jnc-cs-right {
    transform: scale(0.9) rotateY(-14deg);
    transform-origin: left center;
  }
}
@media (min-width: 768px) {
  .jnc-crosssell-track-wrap {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    padding: 0;
  }
  .jnc-crosssell-track-wrap::-webkit-scrollbar { display: none; }
  .jnc-crosssell-tiles {
    display: flex;
    gap: 1px;
    background: #FFFFFF;
  }
  .jnc-crosssell-tile {
    /* Default desktop width: 4 tiles fit the row exactly. The data-tile-
       count override below narrows each tile when there are 5 or 6 so a
       strip of the 5th peeks in — a visual cue that the row swipes,
       matching the home page's "THE EDIT" strip exactly. ≤ 4 tiles keep
       25% each and cover the whole row so the layout doesn't look broken
       on thin pages. */
    flex: 0 0 calc(25% - 0.75px);
    min-width: 0;
    scroll-snap-align: start;
    /* Hard-reset every coverflow property so a desktop tile is a plain
       un-dimmed, un-scaled, un-tilted image again. The mobile-only
       @media block above now holds those effects, but a defensive reset
       here keeps the two fully decoupled even if a future edit widens
       the mobile selectors by accident. */
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
    transition: none;
  }
  /* 5 or 6 tiles → narrow each so the 5th peeks in. 23.5% matches THE
     EDIT on the home page so the two strips have the same visual
     rhythm; 4 tiles take 94% of the row and the 5th sits with about a
     quarter of its width visible past them — enough to read as a peek,
     not enough to look like a cut-off tile. */
  .jnc-crosssell-tiles[data-tile-count="5"] > .jnc-crosssell-tile,
  .jnc-crosssell-tiles[data-tile-count="6"] > .jnc-crosssell-tile {
    flex: 0 0 23.5%;
  }
  .jnc-crosssell-tile[aria-hidden] { display: none; }
}

.jnc-crosssell-tile-img {
  aspect-ratio: 3 / 4;
