/* ─── CATEGORY FILTER PILLS (Change 3) ─── */
.jnc-filter-pills-wrap {
  display: flex;
  flex-direction: row;
  gap: 18px;
  margin-top: 0;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  /* min-width:0 lets this shrink below its own content width so the row
     scrolls instead of shoving the arrows off-screen; max-width keeps it
     inside the page at every width. Deliberately flex-start, NOT center:
     centring a scroll container whose content overflows makes the first
     item permanently unreachable in every engine. .jnc-subrow does the
     centring itself, which only has any visible effect when the row
     actually fits without overflow. */
  justify-content: flex-start;
  min-width: 0;
  max-width: 100%;
}
@media (min-width: 768px) {
  .jnc-filter-pills-wrap { gap: 24px; }
