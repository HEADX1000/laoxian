  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #1a1a1a;
}
.jnc-qa-close {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 22px;
  color: #1a1a1a;
  /* 32px box rather than the old 28px, and -8px of margin so the tappable
     area reaches the sheet's own edge without pushing the × off-centre. */
  width: 32px;
  height: 32px;
  margin-right: -8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Bricolage Grotesque', sans-serif;
  transition: opacity 0.2s;
}
@media (hover: hover) and (pointer: fine) {
  .jnc-qa-close:hover { opacity: 0.6; }
}
/* Everything between the pinned header and the pinned footer. */
.jnc-qa-scroll {
  flex: 1 1 auto;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
/* Desktop takes the inner scroller away entirely so the modal shows in one
   frame. This override has to sit AFTER the base rule rather than up in the
   media query with the rest of the desktop sheet styles: both selectors are
   a single class, so neither wins on specificity and the one written later
   in the file is the one that applies. Placed any earlier and the base rule
   above would simply undo it.

   flex: 0 0 auto means this is never the child the column shrinks when
   space is tight — combined with bottom:auto on the open modal, the sheet
   now grows to its content instead of squeezing the options. */
@media (min-width: 768px) {
  .jnc-qa-scroll {
    flex: 0 0 auto;
    overflow: visible;
  }
}
.jnc-qa-product-row {
  display: flex;
  gap: 14px;
