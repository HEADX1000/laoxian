  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #1a1a1a;
  cursor: pointer;
  white-space: nowrap;
  /* Underlined because it is the one secondary action in the sheet and has
     to read as tappable next to a plain label without competing with the
     size chips below it. */
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: opacity 0.2s;
}
@media (hover: hover) and (pointer: fine) {
  .jnc-qa-measure-btn:hover { opacity: 0.6; }
}
.jnc-qa-option-btn-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.jnc-qa-option-btn {
  min-width: 48px;
  height: 48px;
  padding: 0 14px;
  border: 1px solid #d8d8d8;
  border-radius: 2px;
  background: #FFFFFF;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #1a1a1a;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease, opacity 0.15s;
