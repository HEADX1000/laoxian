  text-transform: uppercase; color: #1a1a1a; line-height: 1.25; margin-bottom: 4px;
}
.jnc-qa-product-color {
  font-family: 'Bricolage Grotesque', sans-serif; font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.5px; color: #666666; margin-bottom: 5px;
}
.jnc-qa-product-price { font-family: 'Bricolage Grotesque', sans-serif; font-size: 13px; font-weight: 800; color: #1a1a1a; }
.jnc-qa-body { padding: 20px 24px 24px; }
.jnc-qa-options { display: flex; flex-direction: column; gap: 24px; }
.jnc-qa-option-group:last-child { margin-bottom: 0; }
/* Label left, SIZE GUIDE right — the same row shape the PDP uses for its
   own SIZES / SEE MEASUREMENTS pair, so the two pages read identically. */
.jnc-qa-option-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; gap: 16px; }
.jnc-qa-option-row-label {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #1a1a1a;
}
.jnc-qa-measure-btn {
  flex-shrink: 0;
  background: none;
  border: none;
  padding: 0;
  font-family: 'Bricolage Grotesque', sans-serif;
