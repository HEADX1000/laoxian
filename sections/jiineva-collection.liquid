      <span class="jnc-qa-title" id="jnc-qa-title">SELECT SIZE</span>
      <button class="jnc-qa-close" id="jnc-qa-close" aria-label="Close">&#215;</button>
    </div>
    <!-- Only this middle section scrolls; header above and footer below are
         pinned by the sheet's flex column, so ADD TO CART can never end up
         below the fold the way it did before. -->
    <div class="jnc-qa-scroll">
      <div class="jnc-qa-product-row">
        <img class="jnc-qa-product-img" id="jnc-qa-img" alt="" loading="lazy">
        <div class="jnc-qa-product-info">
