@media (hover: hover) and (pointer: fine) {
  .jnc-qa-option-btn:hover { border-color: #1a1a1a; }
}
.jnc-qa-option-btn.is-active {
  background: #1a1a1a;
  border-color: #1a1a1a;
  color: #FFFFFF;
}
/* Sold out reads as sold out at a glance — struck through and muted,
   rather than the old version's grey text that looked much like an
   ordinary unselected size. */
.jnc-qa-option-btn.is-oos {
  color: #B5B5B5;
  border-color: #ececec;
  background: #FFFFFF;
  cursor: not-allowed;
  text-decoration: line-through;
}
@media (hover: hover) and (pointer: fine) {
  .jnc-qa-option-btn.is-oos:hover { border-color: #ececec; }
}
.jnc-qa-option-btn.is-adding { opacity: 0.5; pointer-events: none; }
.jnc-qa-empty {
  font-family: 'Bricolage Grotesque', sans-serif; font-size: 11px; color: #999999;
  text-transform: uppercase; letter-spacing: 1px; padding: 4px 0;
}
/* ─── Footer — pinned, so ADD TO CART is reachable without scrolling. ── */
.jnc-qa-footer {
  flex-shrink: 0;
  padding: 16px 24px;
  /* Clears the home-indicator strip on gesture-nav phones. Falls back to
     the plain 16px anywhere env() is unsupported. */
  padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
  border-top: 1px solid #e8e8e8;
  background: #FFFFFF;
}
.jnc-qa-nudge {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #C0392B;
}
.jnc-qa-nudge:not([hidden]) { margin-bottom: 10px; }
.jnc-qa-actions { display: flex; flex-direction: column; gap: 8px; }
.jnc-qa-add-btn {
  width: 100%;
  height: 52px;
  /* position:relative + overflow:hidden anchor the ::after shine sweep
     below so it never leaks past the button corners — same shape as
     the PDP's .jnp-add-to-bag. */
  position: relative;
  overflow: hidden;
  background: #1a1a1a;
  color: #FFFFFF;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 2px;
  border: 1px solid #1a1a1a;
  border-radius: 2px;
  cursor: pointer;
  transition: opacity 0.2s;
  line-height: 1;
}
/* ─── SHINE on ADD TO CART inside the quick-add sheet — same 2.5 s pace,
   same sweep geometry as .jnp-add-to-bag on the PDP. Compositor-only
   (transform), pointer-events:none so it never swallows a click. ── */
.jnc-qa-add-btn::after {
  content: '';
  position: absolute;
  top: 0; bottom: 0; left: 0;
  width: 60%;
  background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.45) 50%, rgba(255,255,255,0) 100%);
  transform: translateX(-180%) skewX(-20deg);
  animation: jnc-qa-add-shine 2.5s ease-in-out infinite;
  pointer-events: none;
}
@keyframes jnc-qa-add-shine {
  0%   { transform: translateX(-180%) skewX(-20deg); }
  18%  { transform: translateX(320%)  skewX(-20deg); }
  100% { transform: translateX(320%)  skewX(-20deg); }
}
@media (prefers-reduced-motion: reduce) {
  .jnc-qa-add-btn::after { animation: none; opacity: 0; }
}
.jnc-qa-add-btn.is-adding::after { animation: none; opacity: 0; }
/* Desktop-only — otherwise a mobile tap leaves this stuck at its hover
   opacity (a "slight grey" that doesn't clear) until another tap lands
   elsewhere, including right after coming back via the browser's back
   button. */
@media (hover: hover) and (pointer: fine) {
  .jnc-qa-add-btn:hover { opacity: 0.85; }
}
.jnc-qa-add-btn.is-adding { opacity: 0.5; pointer-events: none; }
.jnc-qa-buy-btn {
  width: 100%;
  height: 52px;
  background: transparent;
  color: #1a1a1a;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 2px;
  border: 1px solid #1a1a1a;
  border-radius: 2px;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
  line-height: 1;
}
/* Desktop-only — otherwise a mobile tap turns this solid black and leaves
   it there until another tap lands elsewhere, including right after coming
   back via the browser's back button (touchscreens can apply :hover on tap
   and never clear it on their own). */
@media (hover: hover) and (pointer: fine) {
  .jnc-qa-buy-btn:hover { background: #1a1a1a; color: #FFFFFF; }
}
.jnc-qa-buy-btn.is-adding { opacity: 0.5; pointer-events: none; }

/* ─── MEASUREMENT GUIDE PANEL — the collection-page twin of the PDP's
   #jnp-detail-overlay-panel, rebuilt here under the jnc- prefix because
   this page never loads jiineva-product.css and stays self-contained.
   Same 420px right-hand slide-in, same header/typography, same full-width
   treatment on mobile, so a shopper who has seen it on a product page
   meets exactly the same panel here.

   Sits at z-index 310/311 — above the size sheet (209/210) rather than
   replacing it, so closing the guide returns the shopper to the sheet
   with their size selection still intact. ── */

.jnc-detail-overlay-bg {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.2);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  z-index: 310;
  display: none;
}
.jnc-detail-overlay-bg.jnp-open { display: block; }
.jnc-detail-overlay-panel {
  position: fixed;
  top: 0;
  right: -440px;
  width: 420px;
  max-width: 100vw;
  height: 100vh;
  height: 100dvh;
  background: #FFFFFF;
  z-index: 311;
  overflow-y: auto;
  transition: right 0.3s ease;
  border-left: 1px solid #e8e8e8;
}
.jnc-detail-overlay-panel.jnp-open { right: 0; }
.jnc-detail-overlay-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid #e8e8e8;
  position: sticky;
  top: 0;
  background: #FFFFFF;
  z-index: 1;
}
.jnc-detail-overlay-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #1a1a1a;
}
.jnc-detail-overlay-close {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 22px;
  color: #1a1a1a;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Bricolage Grotesque', sans-serif;
  transition: opacity 0.2s;
}
@media (hover: hover) and (pointer: fine) {
  .jnc-detail-overlay-close:hover { opacity: 0.6; }
}
.jnc-detail-overlay-body {
  padding: 24px;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 10px;
  font-weight: 600;
  color: #666666;
  line-height: 1.9;
  letter-spacing: 0.3px;
}
/* The guides are rich text, so the lists inside them need their own
   indent — the PDP leaves padding-left at 0, which pulls the bullets out
   past the panel's own padding. */
.jnc-detail-overlay-body ul,
.jnc-detail-overlay-body ol { padding-left: 18px; margin: 10px 0; }
.jnc-detail-overlay-body li { margin-bottom: 6px; }
.jnc-detail-overlay-body p { margin: 0 0 12px; }
.jnc-detail-overlay-body p:last-child { margin-bottom: 0; }
.jnc-detail-overlay-body strong { color: #1a1a1a; font-weight: 800; }
@media (max-width: 767px) {
  .jnc-detail-overlay-panel { width: 100%; right: -100vw; }
  .jnc-detail-overlay-panel.jnp-open { right: 0; }
}

/* ═══════════════════════════════════════════════════════════════════
   COLLECTION FILTER — modelled directly on the reference site's own
   filter, measured from it rather than eyeballed.

   The numbers that matter, taken off theirs: panel 240px wide on desktop;
   everything animates over 0.3s ease; section titles 12px uppercase 700;
   options 12px 400 in #757575, turning #1a1a1a 700 when chosen. There are
   no pills, no checkboxes and no boxes anywhere in it — selection is shown
   by weight and colour alone, which is what keeps it feeling like a quiet
   index rather than a form.

   Two genuinely different shapes, because the reference has two:

   DESKTOP (>=768px) — a 240px column that pushes in from the left and
   shoves the grid across. Choosing anything applies it IMMEDIATELY; there
   is no confirm step, because the results are right there to see.

   MOBILE (<768px) — a full-screen takeover, because 240px of sidebar on a
   375px screen would leave no room for the grid it is filtering. Here
   choices are STAGED, not applied: a live "SEE RESULTS (n)" count at the
   bottom tells the shopper what they would get, and nothing changes behind
   them until they commit. That difference is deliberate in the original
   and is the single most important thing to copy — on a phone you cannot
   see the grid while filtering, so instant-apply would mean tapping blind.
   ═══════════════════════════════════════════════════════════════════ */

/* ─── The bar holding the FILTER trigger and the result count ───
   This bar no longer carries its own background, blur, border, or sticky
   position — all four live on .jnc-stickybar (the shared wrapper around
   both bars) now, so there's one surface, one blur, and no seam between
   this bar and the subcategory row above. The wrapper is also what
   handles the scroll-direction tuck: on scroll down the row above
   collapses, this bar stays. */
.jnc-filterbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  background: transparent;
  border: none;
}
@media (min-width: 768px) { .jnc-filterbar { padding: 14px 32px; } }
@media (min-width: 1024px) { .jnc-filterbar { padding: 14px 48px; } }
.jnc-filter-toggle,
.jnc-filter-count {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #1a1a1a;
  background: none;
  border: none;
  padding: 0;
  line-height: 1.5;
}
.jnc-filter-toggle { cursor: pointer; display: inline-flex; align-items: center; gap: 7px; }
@media (hover: hover) and (pointer: fine) { .jnc-filter-toggle:hover { opacity: 0.55; } }
/* A dot appears beside FILTER whenever something is active — the shopper
   can tell at a glance that the grid is filtered even with the panel shut,
   which is the one thing a bare "FILTER" label cannot communicate. */
.jnc-filter-dot { width: 6px; height: 6px; border-radius: 50%; background: #00c853; display: none; }
.jnc-filterbar.is-filtered .jnc-filter-dot { display: block; }
.jnc-filter-count { font-weight: 400; color: #757575; }

/* ─── Desktop layout: the panel occupies real space and the grid moves ─── */
.jnc-layout { display: block; }
.jnc-filter-wrap {
  /* Width is what animates, so the grid slides across rather than being
     covered — matching the reference, where the panel is part of the
     layout and not an overlay. clip stops the 240px of content showing
     while the wrapper is closed at 0. */
  width: 0;
  /* Clipped on the X axis ONLY. A plain overflow:hidden/clip here would
     make this box the scrollport for everything inside it, and the sticky
     panel would then stick to this box rather than to the page — i.e. not
     stick at all. overflow-x:clip paired with overflow-y:visible is the
     one combination that hides the 240px of panel while the wrapper is
     closed at 0 without creating that scrollport. */
  overflow-x: clip;
  overflow-y: visible;
  transition: width 0.3s ease;
  flex-shrink: 0;
}
@media (min-width: 768px) {
  /* stretch, not flex-start: the wrapper has to be as tall as the grid
     beside it or the sticky panel inside it has nowhere to travel to and
     simply never sticks (a sticky box can only move within its own
     containing block). */
  .jnc-layout { display: flex; align-items: stretch; }
  .jnc-layout.is-open .jnc-filter-wrap { width: 240px; }
  .jnc-layout > .jnc-grid-col { flex: 1 1 auto; min-width: 0; }
}
.jnc-filter-panel {
  width: 240px;
  background: #FFFFFF;
  /* Sticky so the filter stays reachable while the grid scrolls past it,
     exactly as the reference behaves. --jnc-panel-top is published in
     jncSyncStickOffsets() and includes the live nav + subrow + filterbar
     heights, so the panel always lands exactly below the sticky stack
     above it. */
  position: sticky;
  top: var(--jnc-panel-top, 118px);
  /* Symmetric padding: the chevron on the right of each section head used
     to sit at zero right padding and got clipped by the panel's own edge,
     which read as a broken UI detail in a direct comparison with the
     reference; the mobile CLEAR button also looked off-centre because it
     was pinned left with no matching gutter on the right. 20px both sides
     — 24px on wide desktops — keeps every control symmetrically inside
     the column. */
  padding: 20px 20px 24px 20px;
  transform: translateX(-16px);
  opacity: 0;
  transition: transform 0.3s ease, opacity 0.3s ease;
}
@media (min-width: 1024px) {
  /* Symmetric L/R padding so CLEAR and every section head line up on the
     same vertical axis down the column — the asymmetric 48/24 that used
     to be here was left-shifting CLEAR noticeably inside the panel in a
     direct comparison with the reference. The panel's extra width on
     desktop (268) gives CLEAR enough room at 24px either side without
     needing a bespoke max-width. */
  .jnc-filter-panel { padding: 24px 24px; width: 268px; }
}
@media (min-width: 1024px) { .jnc-layout.is-open .jnc-filter-wrap { width: 268px; } }
.jnc-layout.is-open .jnc-filter-panel { transform: translateX(0); opacity: 1; }

/* ─── Sections ─── */
.jnc-fsection { border: none; margin-bottom: 26px; }
.jnc-fsection:last-of-type { margin-bottom: 0; }
.jnc-fsection-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: none;
  border: none;
  padding: 0 0 10px;
  cursor: pointer;
  text-align: left;
}
.jnc-fsection-head[aria-expanded] { cursor: pointer; }
.jnc-fsection-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #1a1a1a;
  line-height: 1.5;
}
.jnc-fsection-chev {
  width: 10px; height: 10px; flex-shrink: 0;
  border-right: 1.5px solid #1a1a1a;
  border-bottom: 1.5px solid #1a1a1a;
  transform: rotate(45deg) translate(-2px, -2px);
  transition: transform 0.3s ease;
}
.jnc-fsection-head[aria-expanded="true"] .jnc-fsection-chev {
  transform: rotate(-135deg) translate(-3px, -3px);
}
/* The accordion itself: height 0 -> measured, 0.3s ease, with visibility
   on a short linear fade so collapsed options are never tabbable. Same
   two-property pairing the reference uses. */
.jnc-fsection-body { height: 0; overflow: hidden; transition: height 0.3s ease; }
.jnc-fsection-body-inner { padding-bottom: 2px; }
.jnc-fsection-body[aria-hidden="true"] { visibility: hidden; transition: height 0.3s ease, visibility 0.1s linear 0.3s; }
.jnc-fsection-body[aria-hidden="false"] { visibility: visible; transition: height 0.3s ease, visibility 0.1s linear; }

/* ─── Options ─── */
.jnc-fopt {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100%;
  background: none;
  border: none;
  padding: 6px 0;
  cursor: pointer;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 12px;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #757575;
  text-align: left;
  line-height: 1.6;
  transition: color 0.15s ease;
}
@media (hover: hover) and (pointer: fine) { .jnc-fopt:hover { color: #1a1a1a; } }
.jnc-fopt.is-on { color: #1a1a1a; font-weight: 700; }
/* Colour swatch, shown only in the Colour section. Border so white and
   other pale shades still read as a chip rather than disappearing. */
.jnc-fswatch {
  width: 12px; height: 12px; flex-shrink: 0;
  border: 1px solid #d8d8d8;
  display: inline-block;
}
/* A size/colour value with nothing left to show gets struck through rather
   than removed, so the row does not reshuffle under the shopper's finger
   as they narrow things down. */
.jnc-fopt.is-empty { color: #c9c9c9; text-decoration: line-through; cursor: not-allowed; }

/* ─── Clear ─── */
.jnc-fclear {
  display: block;
  width: 100%;
  margin-top: 26px;
  padding: 13px 0;
  background: none;
  border: 1px solid #1a1a1a;
  border-radius: 2px;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #1a1a1a;
  cursor: pointer;
  transition: opacity 0.2s, border-color 0.2s, color 0.2s;
}
.jnc-fclear:disabled { border-color: #e0e0e0; color: #c9c9c9; cursor: default; }
@media (hover: hover) and (pointer: fine) { .jnc-fclear:not(:disabled):hover { opacity: 0.6; } }

/* ─── Mobile: full-screen takeover ─── */

@media (max-width: 767px) {
  .jnc-filter-wrap {
    position: fixed;
    inset: 0;
    width: auto;
    overflow: visible;
    z-index: 260;
    transition: none;
    pointer-events: none;
    visibility: hidden;
  }
  .jnc-layout.is-open .jnc-filter-wrap { pointer-events: auto; visibility: visible; }
  .jnc-filter-panel {
    position: fixed;
    inset: 0;
    width: 100%;
    padding: 0;
    background: #FFFFFF;
    transform: translateY(100%);
    opacity: 1;
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .jnc-layout.is-open .jnc-filter-panel { transform: translateY(0); }
  .jnc-fpanel-head {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 18px 20px;
    border-bottom: 1px solid #e8e8e8;
  }
  .jnc-fpanel-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 1.5px; color: #1a1a1a;
  }
  .jnc-fpanel-close {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
    background: none; border: none; font-size: 22px; color: #1a1a1a; cursor: pointer;
    font-family: 'Bricolage Grotesque', sans-serif;
  }
  .jnc-fpanel-scroll { flex: 1 1 auto; overflow-y: auto; padding: 22px 20px 20px; -webkit-overflow-scrolling: touch; }
  .jnc-fpanel-foot {
    flex-shrink: 0;
    padding: 14px 20px;
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid #e8e8e8;
    background: #FFFFFF;
    display: flex; flex-direction: column; gap: 9px;
  }
  .jnc-fapply {
    width: 100%; padding: 16px 0;
    background: #1a1a1a; color: #FFFFFF;
    border: 1px solid #1a1a1a; border-radius: 2px;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;
    cursor: pointer; line-height: 1;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  /* "NO RESULTS" state — the currently staged combination of filters has
     nothing matching behind it, so there is nothing to show if the shopper
     taps "see results". Rather than open an empty grid, the button goes
     grey, un-pressable, and reads "NO RESULTS". CLEAR beside it stays
     clickable so the way out is one tap away. Exactly the reference's
     own empty-state treatment on a phone. */
  .jnc-fapply:disabled,
  .jnc-fapply[aria-disabled="true"] {
    background: #d8d8d8;
    color: #FFFFFF;
    border-color: #d8d8d8;
    cursor: not-allowed;
  }
  .jnc-fclear { margin-top: 0; padding: 16px 0; letter-spacing: 1.5px; }
  .jnc-filter-panel .jnc-fsection { margin-bottom: 30px; }
}
/* The apply button and the panel chrome exist only on mobile. */
@media (min-width: 768px) { .jnc-fpanel-head, .jnc-fpanel-foot { display: none; } }
@media (min-width: 768px) { .jnc-fpanel-scroll { padding: 0; } }

/* ─── No results ─── */
.jnc-noresults { display: none; padding: 64px 20px 72px; text-align: center; }
.jnc-noresults.is-on { display: block; }
.jnc-noresults-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 16px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 0.5px; color: #1a1a1a; margin-bottom: 10px;
}
.jnc-noresults-sub {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 12px; font-weight: 400; color: #757575; line-height: 1.7; margin-bottom: 22px;
}
.jnc-noresults-btn {
  display: inline-block; padding: 14px 30px;
  background: #1a1a1a; color: #FFFFFF; border: 1px solid #1a1a1a; border-radius: 2px;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px;
  cursor: pointer; line-height: 1;
}
@media (hover: hover) and (pointer: fine) { .jnc-noresults-btn:hover { opacity: 0.85; } }

/* ═══ SUBCATEGORY ROW ─ STICKY, FROSTED ═════════════════════════════════════
   Moved out of .jnc-header in the markup, so it is a direct child of the
   page root and position:sticky can travel all the way down the document
   rather than being capped at its old parent's height. Pinned under the
   nav at --jnc-nav-h (published in JS), z-index 98 so it sits under the
   nav (100) and above every grid card.

   The frosted glass is a plain RGBA + backdrop-filter pair: at rest it
   blends in with the white header behind, and the moment the title and
   breadcrumb scroll past it (there is suddenly product grid behind
   instead), the blur reveals itself. One treatment, no scroll listener,
   no "scrolled" class — the browser does the right thing on its own.

   Vertical padding gives the row the band height the reference's own
   subrow has; horizontal padding matches the rest of the page. ___ */
.jnc-subrow {
  display: flex;
  align-items: center;
  gap: 4px;
  justify-content: center;
  /* 10px top / 8px bottom — the filterbar's 12px top below means the
     subcategory text and the FILTER label sit on an even vertical rhythm
     once the two bars touch. */
  padding: 10px 20px 8px;
  /* Transparent; the frosted glass is painted by .jnc-stickybar. */
  background: transparent;
  border: none;
  /* Overflow + height transition give the scroll-down "tuck" something
     to animate — height is pinned to the measured natural height by JS
     on load so the collapse has a defined "from" value. */
  overflow: hidden;
  transition: height 0.28s cubic-bezier(.4, 0, .2, 1),
              padding 0.28s cubic-bezier(.4, 0, .2, 1),
              opacity 0.18s ease;
}
@media (min-width: 768px) { .jnc-subrow { padding: 14px 32px; } }
@media (min-width: 1024px) { .jnc-subrow { padding: 16px 48px; } }

/* ═══ STICKY TOP BAND ─ holds the subcategory row and the FILTER/count bar
   One sticky container, one frosted glass surface, one hairline against
   the grid. Both bars inside are transparent — the wrapper paints them
   together, so there is no seam between the two and no "stack of bars"
   look. 

   SCROLL-DIRECTION AWARE: the reference's mobile page tucks the
   subcategory row up and out of the way on scroll down (only FILTER
   stays), and rolls it back out on scroll up. .is-tucked is toggled by
   the scroll handler further down; the subrow transitions its own
   height / opacity to make that smooth. */
.jnc-stickybar {
  position: sticky;
  top: var(--jnc-nav-h, 57px);
  z-index: 98;
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(18px) saturate(1.1);
  backdrop-filter: blur(18px) saturate(1.1);
  border-bottom: 1px solid rgba(26, 26, 26, 0.06);
  transition: opacity 0.15s ease, visibility 0s linear 0.15s;
}

/* When ANY overlay opens, the stickybar has to get out of the way —
   otherwise its frosted glass sits at the top of the screen through
   whatever just opened and reads as a stale secondary bar over the
   drawer, menu, search, size sheet, measurement guide, mobile filter
   panel, or offers panel.

   Two selectors cover it all:

   (a) body[data-jn-scroll-locked] — set by the shared jnLockBodyScroll()
       in jn-header.liquid, used by the cart drawer, search overlay,
       size sheet, measurement guide, mobile filter panel, offers panel.
       One attribute covers every overlay that locks scroll.

   (b) body:has(#jn-mobile-menu.jn-open) — the hamburger menu is a
       short fixed panel, NOT a full-screen takeover, and is
       deliberately NOT scroll-locking: it closes on any page scroll
       behind it (see jn-header.liquid). But the sticky band at the top
       still has to disappear while it is open, because the hamburger's
       panel drops down from under the nav and the band would sit
       directly over its first few entries. :has() is well-supported in
       every browser this storefront targets (Chrome 105+, Safari 15.4+,
       Firefox 121+). */
body[data-jn-scroll-locked] .jnc-stickybar,
body:has(#jn-mobile-menu.jn-open) .jnc-stickybar {
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.15s ease, visibility 0s linear 0s;
}
.jnc-stickybar .jnc-subrow {
  /* The pinned natural height is written here as a CSS custom property
     by JS, not as an inline height style — inline would outrank the
     tucked override below. */
  height: var(--jnc-subrow-pinned-h, auto);
}
.jnc-stickybar.is-tucked .jnc-subrow {
  height: 0;
  padding-top: 0;
  padding-bottom: 0;
  opacity: 0;
}
/* When the subrow is tucked, the filter panel on the right (desktop)
   needs to slide up to meet the shorter stickybar — otherwise a visible
   gap opens between the stickybar's bottom and the panel's top. The live
   offset is published in JS whenever the tucked state flips. */
.jnc-subrow-arrow {
  flex-shrink: 0; width: 26px; height: 26px;
  display: none; align-items: center; justify-content: center;
  background: none; border: none; cursor: pointer; padding: 0; color: #1a1a1a;
  transition: opacity 0.2s;
}
.jnc-subrow-arrow:disabled { opacity: 0.25; cursor: default; }
.jnc-subrow.has-overflow .jnc-subrow-arrow { display: flex; }
.jnc-subrow-arrow span {
  width: 7px; height: 7px;
  border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
}
.jnc-subrow-arrow--prev span { transform: rotate(135deg); }
.jnc-subrow-arrow--next span { transform: rotate(-45deg); }
/* ═══ FILTER BAR STICKINESS, CLEAR PLACEMENT, PAGINATION ═══════════
   The bar sticks for one reason: on a phone the FILTER button is above the
   grid, and once a shopper has scrolled two rows down an unsticky bar is
   gone — they have to scroll all the way back up to change their mind.
   Pinned under the nav it is always one tap away, which is exactly how the
   reference behaves. z-index 97 keeps it under .jn-nav (100), so the two
   never fight; it only ever needs to out-rank product cards (1–2).
   ══════════════════════════════════════════════════════════════ */
/* .jnc-filterbar is no longer sticky on its own — the wrapper
   .jnc-stickybar above is. Keeping two separate sticky elements would
   mean two separate scroll-direction transitions, and the frosted band
   would come apart on fast scrolls. */

/* The count beside a section title — "COLOUR (2)". Regular weight and grey
   so it reads as a note on the title rather than part of it. */
.jnc-fsection-n { font-weight: 400; color: #757575; }

/* CLEAR exists twice on purpose: once inside the scroll area (desktop,
   where the panel has no footer) and once in the fixed mobile footer
   beside SEE RESULTS. Two elements, each hidden at the other's
   breakpoint — rather than one element re-parented on resize, which
   would drop focus mid-interaction. */
.jnc-fclear--d { display: none; }
@media (min-width: 768px) { .jnc-fclear--d { display: block; } }

/* The sort options are a single-choice list, stacked. */
.jnc-fsection-body-inner { display: block; }

/* While a filter is narrowing the grid, the paginated "SHOWING x OF y"
   line is describing the page, not the matches, so it would sit there
   contradicting the live count in the filter bar. Hidden for as long as a
   filter is on. LOAD MORE stays — it carries the active filter forward in
   its own URL (see the jncLoadMore handler), so page 2 arrives already
   filtered instead of silently dropping the shopper's choice. */
.jnc-layout.is-filtered .jnc-pagination-info { display: none; }

/* Fillers are forced visible with !important (Dawn's base.css hides every
   empty div — see .jnc-blank-filler above), so an inline display:none can
   never switch one off. Hiding them has to be a class that is equally
   !important, or the last row keeps a stale square in it after filtering. */
.jnc-blank-filler.jnc-off { display: none !important; }

</style>

<div class="jnc-page-root">

  <!-- ─── HEADER (announcement bar + nav + mobile menu + search overlay) ───
       Header intentionally not here: JIINEVA Header (jn-header.liquid) is now a real Shopify
       section, added once to the theme's header group, so it renders automatically above
       every page's own content — this one included. No render call needed any more. ── -->

  <!-- ═══════════════════════════════════════════════════
       COLLECTION HEADER
  ═══════════════════════════════════════════════════ -->
  <div class="jnc-header">
    {%- comment -%}
      Breadcrumb removed at the reference's request — their own collection
      pages don't carry one either, and the title + subcategory row below
      it does the same job (you can always tell which collection you're
      in from the h1). Removing it lets the title sit higher and the whole
      header band read tighter, closer to the reference.
    {%- endcomment -%}
    {%- if collection.handle == 'all' -%}
      <h1 class="jnc-title">JEWELRY</h1>
    {%- else -%}
      <h1 class="jnc-title">{{ collection.title }}</h1>
    {%- endif -%}
  </div>

  {%- comment -%}
    ═══ STICKY TOP BAND opens here ══════════════════════════════════════
    Wraps the subcategory row AND the FILTER/count bar in one sticky
    container. The container starts out here (outside the paginate block)
    and its closing </div> is further down, right after the FILTER bar
    (inside the paginate block) — Liquid is just text processing, and
    the browser sees the opening and closing tags in the right order.
    One sticky element so the two bars share one frosted glass surface,
    with no seam, and so scroll-direction tucking affects both bars'
    joint position atomically — no splitting apart on fast scrolls.

    SUBCATEGORY ROW — moved out of .jnc-header so position-sticky can
    travel the full document height; a sticky element stops at its own
    parent's bottom, and keeping this inside the header would unstick it
    the moment the title scrolled off. First "ALL/ALL EARRINGS" is now
    "SEE ALL" at the reference's request — shorter, matches the way
    their own row reads. The two arrows only appear when the row actually
    overflows (.has-overflow, set in JS); tabindex=-1 keeps them out of
    the tab order since they only duplicate scrolling a keyboard user
    gets for free from the row itself.
  {%- endcomment -%}
  <div class="jnc-stickybar" id="jnc-stickybar">
  {%- if collection.handle == 'all' -%}
  {%- comment -%}
    ═══ SHOP ALL SUBCATEGORY PILLS ─ one source of truth ═══════════════════

    Three sources, in priority. Pills FILTER the grid in place — they
    NEVER navigate away — so a tap on EARRINGS stays on /collections/all
    with only the earrings visible. The data-filter-type="collection"
    attribute hands each pill to the filter engine, which already knows
    how to match against each product card's data-collections.

    (1) The Shop All collection's OWN "Subcategory Pills" metafield
        (custom.subcategory_pills). THIS IS THE ONE PLACE to add new
        collections going forward — open the Shop All collection in
        Admin, scroll to Metafields → Subcategory Pills, add the new
        collection, save. The pill appears on Shop All, Best Sellers,
        and New In automatically on the next page load. Same
        mechanism, same page, same workflow as subcategory pills on
        individual collection pages.

    (2) If the metafield is empty, the Customize "Filter Pill" blocks
        on this section are rendered instead. Kept so an existing
        Customize setup keeps working — they just now render as FILTER
        buttons instead of navigation links.

    (3) If both are empty, the three built-in pills EARRINGS /
        NECKLACES / BRACELETS appear as a sensible default so the row
        is never empty on a fresh install.
  {%- endcomment -%}
  {%- assign jnc_shop_all_pills = collection.metafields.custom.subcategory_pills.value -%}
  <div class="jnc-subrow">
    <button type="button" class="jnc-subrow-arrow jnc-subrow-arrow--prev" aria-label="Scroll categories left" tabindex="-1"><span aria-hidden="true"></span></button>
    <div class="jnc-filter-pills-wrap" role="group" aria-label="Shop by category">
      <button class="jnc-fpill jnc-fpill--active" data-filter="all">SEE ALL</button>
      {%- if jnc_shop_all_pills != blank and jnc_shop_all_pills.size > 0 -%}
        {%- for sub_coll in jnc_shop_all_pills -%}
          {%- if sub_coll != blank -%}
            <button class="jnc-fpill" data-filter="{{ sub_coll.handle }}" data-filter-type="collection">{{ sub_coll.title | upcase }}</button>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign jnc_has_blocks = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'filter_pill' and block.settings.collection != blank -%}
            {%- assign jnc_has_blocks = true -%}
            <button class="jnc-fpill" data-filter="{{ block.settings.collection.handle }}" data-filter-type="collection" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | upcase }}</button>
          {%- endif -%}
        {%- endfor -%}
        {%- unless jnc_has_blocks -%}
          <button class="jnc-fpill" data-filter="earrings" data-filter-type="collection">EARRINGS</button>
          <button class="jnc-fpill" data-filter="necklaces" data-filter-type="collection">NECKLACES</button>
          <button class="jnc-fpill" data-filter="bracelets" data-filter-type="collection">BRACELETS</button>
        {%- endunless -%}
      {%- endif -%}
    </div>
    <button type="button" class="jnc-subrow-arrow jnc-subrow-arrow--next" aria-label="Scroll categories right" tabindex="-1"><span aria-hidden="true"></span></button>
  </div>
  {%- else -%}
    {%- comment -%}
      Individual collection page (e.g. /collections/earrings). Three
      sources for the pills, in order:

      (1) The collection's OWN metafield custom.subcategory_pills — a
          list of collections set on that collection's Admin page. If
          filled in, this wins. Every collection can carry a bespoke
          pill set this way (e.g. EARRINGS → HOOPS / STUDS / DROPS).

      (2) BEST SELLERS and NEW IN inherit Shop All's pill set when
          their own metafield is blank. The intent: a shopper browsing
          bestsellers typically still wants to narrow by top-level
          category (earrings vs necklaces vs bracelets), and
          maintaining the same list on each page by hand would mean
          editing three metafields every time a new category joins.
          Pulling from Shop All's own Filter Pill section blocks + the
          three built-ins means ONE Customize edit propagates to all
          three. The collection reference metafield still overrides —
          set it on best-sellers if you ever want a different set
          there.

      (3) Any other collection with a blank metafield renders no pills
          (silent), same as before.

      NOTE: the pills render as <button data-filter-type="collection">,
      not <a href>. The filter engine's jncMatchesSub() already knows to
      match a data-filter against each card's data-collections, so
      clicking EARRINGS on Best Sellers shows bestseller products that
      are ALSO in Earrings — no new filter path needed. SEE ALL is the
      default active pill on every page load.
    {%- endcomment -%}
    {%- assign jnc_subcat_pills = collection.metafields.custom.subcategory_pills.value -%}
    {%- assign jnc_inherit_shop_all = false -%}
    {%- if jnc_subcat_pills == blank or jnc_subcat_pills.size == 0 -%}
      {%- if collection.handle == 'best-sellers' or collection.handle == 'new-in' -%}
        {%- assign jnc_inherit_shop_all = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- if jnc_subcat_pills != blank and jnc_subcat_pills.size > 0 -%}
    <div class="jnc-subrow">
      <button type="button" class="jnc-subrow-arrow jnc-subrow-arrow--prev" aria-label="Scroll categories left" tabindex="-1"><span aria-hidden="true"></span></button>
      <div class="jnc-filter-pills-wrap" role="group" aria-label="Filter by category">
        <button class="jnc-fpill jnc-fpill--active" data-filter="all">SEE ALL</button>
        {%- for sub_coll in jnc_subcat_pills -%}
          {%- if sub_coll != blank -%}
            <button class="jnc-fpill" data-filter="{{ sub_coll.handle }}" data-filter-type="collection">{{ sub_coll.title | upcase }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="jnc-subrow-arrow jnc-subrow-arrow--next" aria-label="Scroll categories right" tabindex="-1"><span aria-hidden="true"></span></button>
    </div>
    {%- elsif jnc_inherit_shop_all -%}
    {%- comment -%}
      Best Sellers / New In inherit Shop All's pill set so the three
      pages feel like one system. Priority matches Shop All exactly:
      Shop All's metafield wins, then Customize blocks, then the three
      built-ins. Add a new collection to Shop All's Subcategory Pills
      metafield once — it appears here automatically on the next load.
    {%- endcomment -%}
    {%- assign jnc_inherited_pills = collections['all'].metafields.custom.subcategory_pills.value -%}
    <div class="jnc-subrow">
      <button type="button" class="jnc-subrow-arrow jnc-subrow-arrow--prev" aria-label="Scroll categories left" tabindex="-1"><span aria-hidden="true"></span></button>
      <div class="jnc-filter-pills-wrap" role="group" aria-label="Filter by category">
        <button class="jnc-fpill jnc-fpill--active" data-filter="all">SEE ALL</button>
        {%- if jnc_inherited_pills != blank and jnc_inherited_pills.size > 0 -%}
          {%- for sub_coll in jnc_inherited_pills -%}
            {%- if sub_coll != blank -%}
              <button class="jnc-fpill" data-filter="{{ sub_coll.handle }}" data-filter-type="collection">{{ sub_coll.title | upcase }}</button>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign jnc_inh_has_blocks = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'filter_pill' and block.settings.collection != blank -%}
              {%- assign jnc_inh_has_blocks = true -%}
              <button class="jnc-fpill" data-filter="{{ block.settings.collection.handle }}" data-filter-type="collection" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | upcase }}</button>
            {%- endif -%}
          {%- endfor -%}
          {%- unless jnc_inh_has_blocks -%}
            <button class="jnc-fpill" data-filter="earrings" data-filter-type="collection">EARRINGS</button>
            <button class="jnc-fpill" data-filter="necklaces" data-filter-type="collection">NECKLACES</button>
            <button class="jnc-fpill" data-filter="bracelets" data-filter-type="collection">BRACELETS</button>
          {%- endunless -%}
        {%- endif -%}
      </div>
      <button type="button" class="jnc-subrow-arrow jnc-subrow-arrow--next" aria-label="Scroll categories right" tabindex="-1"><span aria-hidden="true"></span></button>
    </div>
    {%- endif -%}
  {%- endif -%}

  <!-- ═══════════════════════════════════════════════════
       PRODUCT GRID
  ═══════════════════════════════════════════════════ -->
  {%- paginate collection.products by 16 -%}

  {%- comment -%}
    COLOUR FACET — assembled from the products actually on this page, and
    from nothing else. There is no hardcoded list of colours anywhere: if
    no product in this collection has a Color (or Colour) option, the list
    comes out empty and the whole COLOUR section below is never rendered,
    exactly as asked. One distinct value is treated the same as none — a
    filter with a single option cannot narrow anything, so it would only
    be clutter.

    The membership test is deliberately delimited ('|Gold|' inside
    '|Gold|Rose Gold|'), not a bare `contains`: a plain substring test
    would see "Gold" already present the moment "Rose Gold" had been
    added and silently drop it.

    Scanned INSIDE the paginate block on purpose. Everything the panel
    filters is the DOM of this page, so the options have to describe this
    page's 16 products — not the collection's full catalogue, which would
    offer colours with nothing to show behind them.
  {%- endcomment -%}
  {%- assign jnc_color_bag = '|' -%}
  {%- for jnc_cp in collection.products -%}
    {%- for jnc_opt in jnc_cp.options_with_values -%}
      {%- assign jnc_optn = jnc_opt.name | downcase | strip -%}
      {%- if jnc_optn == 'color' or jnc_optn == 'colour' -%}
        {%- for jnc_val in jnc_opt.values -%}
          {%- assign jnc_v = jnc_val | strip -%}
          {%- if jnc_v != blank -%}
            {%- assign jnc_probe = jnc_v | prepend: '|' | append: '|' -%}
            {%- unless jnc_color_bag contains jnc_probe -%}
              {%- assign jnc_color_bag = jnc_color_bag | append: jnc_v | append: '|' -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- assign jnc_color_list = jnc_color_bag | remove_first: '|' | split: '|' -%}

  <!-- ═════════════════════════════════════════════════════
       FILTER BAR — the trigger, an "it is on" dot, and a live count
  ═════════════════════════════════════════════════════ -->
  <div class="jnc-filterbar" id="jnc-filterbar">
    <button type="button" class="jnc-filter-toggle" id="jnc-filter-toggle" aria-expanded="false" aria-controls="jnc-filter-panel">
      <span id="jnc-filter-toggle-label">FILTER</span>
      <span class="jnc-filter-dot" aria-hidden="true"></span>
    </button>
    <span class="jnc-filter-count" id="jnc-filter-count" aria-live="polite"></span>
  </div>
  </div><!-- /.jnc-stickybar — closes the wrapper opened above the subrow -->

  <div class="jnc-layout" id="jnc-layout">

    <!-- ═══ THE PANEL — one set of markup, two shapes ══════════════════
         Desktop: a 240px column inside .jnc-filter-wrap, whose width is
         what animates, so the grid slides across instead of being covered.
         Mobile: the same panel goes position:fixed and takes the whole
         screen, with the head and foot below (hidden on desktop) coming
         into play. Nothing is duplicated and nothing is re-parented — it
         is one panel that CSS reshapes at 768px.
    ═════════════════════════════════════════════════════ -->
    <div class="jnc-filter-wrap" id="jnc-filter-wrap">
      <div class="jnc-filter-panel" id="jnc-filter-panel" role="group" aria-label="Filter and sort">

        <div class="jnc-fpanel-head">
          <span class="jnc-fpanel-title">FILTER</span>
          <button type="button" class="jnc-fpanel-close" id="jnc-fpanel-close" aria-label="Close filters">&#215;</button>
        </div>

        <div class="jnc-fpanel-scroll">

          <div class="jnc-fsection">
            <button type="button" class="jnc-fsection-head" aria-expanded="true" aria-controls="jnc-fbody-sort">
              <span class="jnc-fsection-title">SORT BY</span>
              <span class="jnc-fsection-chev" aria-hidden="true"></span>
            </button>
            <div class="jnc-fsection-body" id="jnc-fbody-sort" aria-hidden="false">
              <div class="jnc-fsection-body-inner">
                <button type="button" class="jnc-fopt is-on" data-sort="popular" aria-pressed="true">POPULAR</button>
                <button type="button" class="jnc-fopt" data-sort="new" aria-pressed="false">NEW IN</button>
                <button type="button" class="jnc-fopt" data-sort="best" aria-pressed="false">BEST SELLING</button>
                <button type="button" class="jnc-fopt" data-sort="price-asc" aria-pressed="false">PRICE: LOW TO HIGH</button>
                <button type="button" class="jnc-fopt" data-sort="price-desc" aria-pressed="false">PRICE: HIGH TO LOW</button>
              </div>
            </div>
          </div>

          {%- if jnc_color_list.size > 1 -%}
          <div class="jnc-fsection">
            <button type="button" class="jnc-fsection-head" aria-expanded="true" aria-controls="jnc-fbody-color">
              <span class="jnc-fsection-title">COLOUR<span class="jnc-fsection-n" id="jnc-fsection-n-color"></span></span>
              <span class="jnc-fsection-chev" aria-hidden="true"></span>
            </button>
            <div class="jnc-fsection-body" id="jnc-fbody-color" aria-hidden="false">
              <div class="jnc-fsection-body-inner">
                {%- for jnc_c in jnc_color_list -%}
                <button type="button" class="jnc-fopt" data-color="{{ jnc_c | escape }}" aria-pressed="false"><span class="jnc-fswatch" aria-hidden="true"></span>{{ jnc_c | upcase }}</button>
                {%- endfor -%}
              </div>
            </div>
          </div>
          {%- endif -%}

          <button type="button" class="jnc-fclear jnc-fclear--d" id="jnc-fclear-d" disabled>CLEAR</button>
        </div>

        <div class="jnc-fpanel-foot">
          <button type="button" class="jnc-fapply" id="jnc-fapply">SEE RESULTS</button>
          <button type="button" class="jnc-fclear" id="jnc-fclear-m" disabled>CLEAR</button>
        </div>

      </div>
    </div>

    <div class="jnc-grid-col">

  <div class="jnc-product-grid" id="jnc-grid" role="list">
    {%- comment -%}
      jnc_prod_count is now taken from forloop.length, captured on the first
      iteration — this is the actual, unambiguous count of items this loop
      executes for THIS page, unlike collection.products.size, which does
      not reliably reflect the current paginated page in every case and was
      the root cause of the grey fallback showing on some pages.
    {%- endcomment -%}
    {%- assign jnc_prod_count = 0 -%}
    {%- for product in collection.products -%}
      {%- if forloop.first -%}{%- assign jnc_prod_count = forloop.length -%}{%- endif -%}
      {%- comment -%} 30-day NEW badge detection {%- endcomment -%}
      {%- assign jnc_thirty_days_ago = 'now' | date: '%s' | plus: 0 | minus: 2592000 -%}
      {%- assign jnc_created = product.created_at | date: '%s' | plus: 0 -%}
      {%- assign jnc_is_new = false -%}
      {%- if jnc_created > jnc_thirty_days_ago -%}{%- assign jnc_is_new = true -%}{%- endif -%}

      {%- comment -%}
        Same automatic "(X% OFF)" badge as the PDP (see jnp-price in
        jiineva-product.liquid) and the cart drawer, just computed from the
        product-level fields collection grids use instead of a single
        variant: product.price / product.compare_at_price both resolve to
        the LOWEST value across the product's variants (that's how the
        plain price above already worked before this edit), so the two stay
        paired the same way they always have — this doesn't change which
        price shows, only adds the compare-at + percentage beside it.
      {%- endcomment -%}

      {%- comment -%}
        This card's own colours, same Color/Colour option scan as the facet
        list above. Pipe-separated because colour names contain spaces
        ("Rose Gold") and a comma would be ambiguous.
      {%- endcomment -%}
      {%- assign jnc_card_colors = '' -%}
      {%- for jnc_opt2 in product.options_with_values -%}
        {%- assign jnc_optn2 = jnc_opt2.name | downcase | strip -%}
        {%- if jnc_optn2 == 'color' or jnc_optn2 == 'colour' -%}
          {%- assign jnc_card_colors = jnc_opt2.values | join: '|' -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="jn-product-card"
           role="listitem"
           data-category="{{ product.type | downcase }}"
           data-collections="{{ product.collections | map: 'handle' | join: ',' }}"
           data-handle="{{ product.handle }}"
           data-created="{{ product.created_at | date: '%s' }}"
           data-colors="{{ jnc_card_colors | escape }}"
           data-price="{{ product.price }}">
        <a href="{{ product.url }}" class="jn-product-link">
          <div class="jn-product-img-wrap">
            {%- if product.images.size > 0 -%}
              <img
                class="jn-product-img-main"
                src="{{ product.images[0] | image_url: width: 800 }}"
                srcset="{{ product.images[0] | image_url: width: 400 }} 400w, {{ product.images[0] | image_url: width: 600 }} 600w, {{ product.images[0] | image_url: width: 800 }} 800w, {{ product.images[0] | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 768px) 25vw, 50vw"
                alt="{{ product.title | escape }}"
                {%- if forloop.index <= 6 -%} loading="eager" fetchpriority="high"{%- else -%} loading="lazy"{%- endif -%}
                width="800" height="1067"
              >
              {%- if product.images.size > 1 -%}
                <img
                  class="jn-product-img-lifestyle"
                  src="{{ product.images[1] | image_url: width: 800 }}"
                  srcset="{{ product.images[1] | image_url: width: 400 }} 400w, {{ product.images[1] | image_url: width: 600 }} 600w, {{ product.images[1] | image_url: width: 800 }} 800w, {{ product.images[1] | image_url: width: 1000 }} 1000w"
                  sizes="(min-width: 768px) 25vw, 50vw"
                  alt="{{ product.title | escape }} worn"
                  loading="lazy"
                  width="800" height="1067"
                >
              {%- endif -%}
            {%- endif -%}
            {%- comment -%}
              REVIEW RATING BADGE — same review_widget_data source as the PDP's
              own "FIX 6" (product.metafields.judgeme.rating / rating_count are
              never populated on this store; review_widget_data is the one
              Judge.me actually keeps current). Defaults to 5.0 with no visible
              count when a product has zero reviews yet, per spec.
            {%- endcomment -%}
            {%- assign jnc_rwd_mf = product.metafields.judgeme.review_widget_data -%}
            {%- if jnc_rwd_mf.type == 'json' -%}
              {%- assign jnc_rwd = jnc_rwd_mf.value -%}
            {%- else -%}
              {%- assign jnc_rwd = jnc_rwd_mf.value | parse_json -%}
            {%- endif -%}
            {%- comment -%}
              BUG FIX v2: the first version (checking for blank or 0) still
              missed products where Judge.me writes average_rating as a
              numeric-looking STRING ("0" or "0.0") instead of a real
              number — Liquid's == never treats "0" as equal to 0, so that
              shape slipped through and still rendered 0.0. Running it
              through "times: 1.0" first forces either a real number or a
              numeric string into an actual number, so the > 0 check below
              now catches every shape of "no rating yet" correctly.
            {%- endcomment -%}
            {%- assign jnc_card_rating = 5.0 -%}
            {%- if jnc_rwd.average_rating != blank -%}
              {%- assign jnc_card_rating_check = jnc_rwd.average_rating | times: 1.0 -%}
              {%- if jnc_card_rating_check > 0 -%}
                {%- assign jnc_card_rating = jnc_card_rating_check -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign jnc_card_rating_count = jnc_rwd.number_of_reviews | default: 0 -%}
            {%- comment -%} Per-product metafield gate (same as PDP + home): hide
                the star rating on any product that has custom.show_reviews == false. {%- endcomment -%}
            {%- if product.metafields.custom.show_reviews.value != false -%}
            <div class="jn-card-rating">
              <span class="jn-card-rating-star">&#9733;</span><span>{{ jnc_card_rating | round: 1 }}</span>{%- if jnc_card_rating_count > 0 -%}<span class="jn-card-rating-count">&nbsp;|&nbsp;{{ jnc_card_rating_count }}</span>{%- endif -%}
            </div>
            {%- endif -%}
            {%- comment -%}
              ═══ CORNER BADGE ─ single frosted-glass design, three sources ═════════

              The old right-side plain-text NEW and the four colour-coded
              corner badges (NEW LAUNCH / TRENDING / RESTOCKED / SOLD OUT)
              are gone. There is now ONE badge style on the card — the
              frosted glass block top-left — and three sources that can
              feed it, checked in this order so the right one wins every
              time:

              (1) SOLD OUT — automatic, driven by product.available. A
                  sold-out piece shows SOLD OUT and nothing else; it
                  never advertises itself as "new" or carries a custom
                  label. The custom text and the automatic NEW only
                  reappear once stock is back.

              (2) CUSTOM TEXT — whatever the merchant types in the
                  product's Badge Text metafield (custom.badge_text).
                  Free-form, any text at all. Overrides the automatic
                  NEW below: if you set a custom label on a product that
                  would otherwise show NEW, the custom label is what
                  shows (that is literally the point of setting one).

              (3) AUTOMATIC NEW — the 30-day rule. Any in-stock product
                  with no custom label and a created_at within the last
                  30 days (or with the 'new' tag) shows NEW. Disappears
                  on day 31 on its own.

              Setup once in Shopify Admin (if not already done):
                Settings → Custom data → Products → Add definition:
                  Name: Badge Text
                  Namespace and key: custom.badge_text
                  Type: Single line text
                Then on any product: Metafields → Badge Text → type
                anything. It shows on the card immediately.
            {%- endcomment -%}
            {%- assign jnc_badge_label = '' -%}
            {%- if product.available == false -%}
              {%- assign jnc_badge_label = 'SOLD OUT' -%}
            {%- elsif product.metafields.custom.badge_text != blank -%}
              {%- assign jnc_badge_label = product.metafields.custom.badge_text | strip | upcase -%}
            {%- elsif jnc_is_new or product.tags contains 'new' -%}
              {%- assign jnc_badge_label = 'NEW' -%}
            {%- endif -%}
            {%- if jnc_badge_label != blank -%}
              {%- comment -%} Multi-badge: when the metafield contains pipe-separated values
                 (e.g. "NEW | BEST SELLER"), render each as a sibling label; the rotator JS
                 (see jnpBadgeRotator in jiineva-product.liquid, shared across pages) cycles
                 them every 4s. A single-value badge renders as one child and the rotator
                 skips it (length < 2 check). Reuses the PDP's own CSS classes so the fade
                 and layout behaviour is identical everywhere. {%- endcomment -%}
              {%- assign jnc_badge_list = jnc_badge_label | split: '|' -%}
              <span class="jnc-corner-badge jnp-corner-badge-rotator" data-rotate-interval="4000">
                {%- for jnc_b in jnc_badge_list -%}
                  {%- assign jnc_b_clean = jnc_b | strip -%}
                  {%- if jnc_b_clean != '' -%}
                    <span class="jnp-corner-badge-label"{% if forloop.first == false %} hidden{% endif %}>{{ jnc_b_clean | escape }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </span>
            {%- endif -%}
            <div class="jnc-card-icons">
              {%- if product.available -%}
                <button
                  class="jnc-icon-btn"
                  data-cart-add
                  data-variant-id="{{ product.first_available_variant.id }}"
                  data-handle="{{ product.handle }}"
                  data-variant-count="{{ product.variants.size }}"
                  aria-label="Add {{ product.title | escape }} to bag"
                >
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10.5 1c1.125 0 2.17.338 3.041.917v2.849A3.5 3.5 0 0 0 7.337 5h6.204v2H2v14h16V10.766l1.541-.868.459.258V23H0V5h5.208A5.502 5.502 0 0 1 10.5 1Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="m24 10.71-4.5-2.532L15 10.71V0h9v10.71Zm-7-3.42 2.5-1.407L22 7.289V2h-5v5.29Z" fill="currentColor"/></svg>
                </button>
              {%- endif -%}
            </div>
            {%- if product.available -%}
              <button class="jnc-mob-plus-btn" data-cart-add data-variant-id="{{ product.first_available_variant.id }}" data-handle="{{ product.handle }}" data-variant-count="{{ product.variants.size }}" aria-label="Add {{ product.title | escape }} to bag">+</button>
            {%- endif -%}
          </div>
          <div class="jn-product-body">
            <div class="jn-product-name">{{ product.title }}</div>
            {%- comment -%} Headline price = FIRST COLOUR's lowest-priced variant (not the overall
               product min), because the first swatch is auto-active on load. Swatches each carry
               their own colour's lowest-variant price via data-price; the JS swaps the display when
               a different colour is picked. For a product with no colour option, falls through to
               product.price (which is already Shopify's overall min). Compare price follows the
               same variant for discount-%. {%- endcomment -%}
            {%- assign jn_head_color_idx = -1 -%}
            {%- for opt in product.options -%}
              {%- if opt == 'Color' or opt == 'Colour' -%}
                {%- assign jn_head_color_idx = forloop.index0 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign jn_head_price = product.price -%}
            {%- assign jn_head_compare = product.compare_at_price -%}
            {%- if jn_head_color_idx > -1 -%}
              {%- assign jn_head_colors = product.options_with_values[jn_head_color_idx].values -%}
              {%- if jn_head_colors.size > 1 -%}
                {%- assign jn_head_first_color = jn_head_colors.first -%}
                {%- assign jn_head_color_pos = jn_head_color_idx | plus: 1 -%}
                {%- assign jn_head_color_key = 'option' | append: jn_head_color_pos -%}
                {%- assign jn_head_price_calc = 999999999 -%}
                {%- assign jn_head_compare_calc = 0 -%}
                {%- for v in product.variants -%}
                  {%- if v[jn_head_color_key] == jn_head_first_color and v.price < jn_head_price_calc -%}
                    {%- assign jn_head_price_calc = v.price -%}
                    {%- assign jn_head_compare_calc = v.compare_at_price | default: 0 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if jn_head_price_calc < 999999999 -%}
                  {%- assign jn_head_price = jn_head_price_calc -%}
                  {%- assign jn_head_compare = jn_head_compare_calc -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign jn_head_pct = 0 -%}
            {%- if jn_head_compare > jn_head_price -%}
              {%- assign jn_head_pct = jn_head_compare | minus: jn_head_price | times: 100.0 | divided_by: jn_head_compare | round -%}
            {%- endif -%}
            <div class="jn-product-price-row">
              <span class="jn-product-compare-price"{% unless jn_head_compare > jn_head_price %} hidden{% endunless %}>{{ jn_head_compare | money | remove: 'Rs.' | remove: 'INR' | strip | replace: '.00', '' | prepend: '₹' }}</span>
              <span class="jn-product-price">{{ jn_head_price | money | remove: 'Rs.' | remove: 'INR' | strip | replace: '.00', '' | prepend: '₹' }}</span>
              <span class="jn-product-discount-badge"{% unless jn_head_compare > jn_head_price and jn_head_pct > 0 %} hidden{% endunless %}>{{ jn_head_pct }}% OFF</span>
            </div>
            {%- comment -%}
              COLOR SWATCHES — only when this product has a Color/Colour option
              with more than one value (mirrors Ana Luisa's own collection-grid
              rule). Colour name → hex mapping is copied verbatim from the PDP's
              jnp-color-swatch logic in jiineva-product.liquid so a colour reads
              the same everywhere on the site. Representative image per colour
              reuses the same "first variant of this colour with its own tagged
              image, else the product's main image" fallback the PDP already uses.
            {%- endcomment -%}
            {%- assign jn_color_idx = -1 -%}
            {%- for opt in product.options -%}
              {%- if opt == 'Color' or opt == 'Colour' -%}
                {%- assign jn_color_idx = forloop.index0 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if jn_color_idx > -1 -%}
              {%- assign jn_color_values = product.options_with_values[jn_color_idx].values -%}
              {%- if jn_color_values.size > 1 -%}
                {%- assign jn_color_pos = jn_color_idx | plus: 1 -%}
                {%- assign jn_color_key = 'option' | append: jn_color_pos -%}
                <div class="jn-color-swatches" role="group" aria-label="Available colours">
                  {%- for cv in jn_color_values -%}
                    {%- assign _cv = cv | downcase -%}
                    {%- case _cv -%}
                      {%- when 'gold', 'yellow gold', '18k gold', '18k gold vermeil', 'gold vermeil' -%}
                        {%- assign jn_sw_bg = '#D4AF6A' -%}
                      {%- when 'rose gold', 'rose gold vermeil' -%}
                        {%- assign jn_sw_bg = '#E5B7A6' -%}
                      {%- when 'silver', 'sterling silver' -%}
                        {%- assign jn_sw_bg = '#C7C9CC' -%}
                      {%- when 'white gold', 'rhodium', 'platinum' -%}
                        {%- assign jn_sw_bg = '#E8E9EB' -%}
                      {%- when 'black', 'black rhodium', 'gunmetal' -%}
                        {%- assign jn_sw_bg = '#2B2B2B' -%}
                      {%- when 'two tone', 'two-tone' -%}
                        {%- assign jn_sw_bg = 'linear-gradient(135deg,#D4AF6A 50%,#C7C9CC 50%)' -%}
                      {%- else -%}
                        {%- assign jn_sw_bg = '#EAEAEA' -%}
                    {%- endcase -%}
                    {%- assign jn_sw_image = '' -%}
                    {%- comment -%} Capture this colour's LOWEST-priced variant (across all sizes)
                       so the card's headline price reflects the picked colour's own cheapest option
                       — a colour swap is effectively a different product, so the price swaps with it.
                       The image match still uses the "variant with its own photo" preference below. {%- endcomment -%}
                    {%- assign jn_sw_price = 999999999 -%}
                    {%- assign jn_sw_compare = 0 -%}
                    {%- assign jn_sw_variant_id = '' -%}
                    {%- for v in product.variants -%}
                      {%- if v[jn_color_key] == cv and v.price < jn_sw_price -%}
                        {%- assign jn_sw_price = v.price -%}
                        {%- assign jn_sw_compare = v.compare_at_price | default: 0 -%}
                        {%- assign jn_sw_variant_id = v.id -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if jn_sw_variant_id == '' -%}
                      {%- assign jn_sw_price = product.price -%}
                      {%- assign jn_sw_variant_id = product.first_available_variant.id -%}
                    {%- endif -%}
                    {%- for v in product.variants -%}
                      {%- if v[jn_color_key] == cv and v.featured_image -%}
                        {%- assign jn_sw_image = v.featured_image | image_url: width: 800 -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- comment -%} Same "[ColorName]" alt-text tagging convention as the
                       PDP gallery (jiineva-product.liquid) — a photo's alt text containing
                       e.g. "[Gold]" marks it as that colour's photo, uncapped unlike the
                       one-image-per-variant assignment checked just above. Only the first
                       match is kept here (one representative tile photo, not a full
                       gallery), so this stops at the first hit instead of collecting every
                       match like the PDP gallery does. {%- endcomment -%}
                    {%- if jn_sw_image == '' -%}
                      {%- assign jn_alt_tag = '[' | append: _cv | append: ']' -%}
                      {%- for img in product.images -%}
                        {%- if img.alt != blank -%}
                          {%- assign jn_alt_lc = img.alt | downcase -%}
                          {%- if jn_alt_lc contains jn_alt_tag -%}
                            {%- assign jn_sw_image = img | image_url: width: 800 -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {%- if jn_sw_image == '' -%}
                      {%- assign jn_sw_image = product.featured_image | image_url: width: 800 -%}
                    {%- endif -%}
                    <button
                      type="button"
                      class="jn-color-swatch{% if forloop.first %} jn-swatch-active{% endif %}"
                      style="background:{{ jn_sw_bg }};"
                      data-swatch-image="{{ jn_sw_image }}"
                      data-variant-id="{{ jn_sw_variant_id }}"
                      data-price="{{ jn_sw_price }}"
                      data-compare-price="{{ jn_sw_compare }}"
                      title="{{ cv | escape }}"
                      aria-label="{{ cv | escape }}"
                    ></button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </a>
      </div>

    {%- else -%}

      <div class="jnc-empty-collection" role="status">
        <p class="jnc-empty-title">Nothing here just yet.</p>
        <a href="/collections/all" class="jnc-empty-link">BROWSE ALL JEWELRY →</a>
      </div>

    {%- endfor -%}
    {%- assign jnc_remainder = jnc_prod_count | modulo: 4 -%}
    {%- if jnc_remainder != 0 -%}
      {%- assign jnc_blank_fillers = 4 | minus: jnc_remainder -%}
    {%- else -%}
      {%- assign jnc_blank_fillers = 0 -%}
    {%- endif -%}
    {%- if jnc_blank_fillers > 0 and jnc_prod_count > 0 -%}
      {%- for i in (1..jnc_blank_fillers) -%}
        <div class="jnc-blank-filler" role="presentation" aria-hidden="true"></div>
      {%- endfor -%}
    {%- endif -%}

  </div>

  <!-- ═══ NO RESULTS ═════════════════════════════════════════════
       Reachable by combining a subcategory with a colour nothing in it
       comes in — e.g. HOOPS + SILVER when every hoop is gold. The way out
       is a button, not a sentence: the one thing a shopper must never have
       to do here is work out for themselves which of their taps to undo.
  ═════════════════════════════════════════════════════════════════ -->
  <div class="jnc-noresults" id="jnc-noresults">
    <p class="jnc-noresults-title">THERE ARE NO RESULTS</p>
    <p class="jnc-noresults-sub">Try with other filters, or clear the selected filters.</p>
    <button type="button" class="jnc-noresults-btn" id="jnc-noresults-clear">CLEAR FILTERS</button>
  </div>

  <!-- Pagination -->
  {%- if paginate.pages > 1 -%}
    <div class="jnc-pagination">
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="jnc-load-more" id="jnc-load-more">LOAD MORE</a>
      {%- endif -%}
      <p class="jnc-pagination-info">
        SHOWING {{ paginate.page_size | times: paginate.current_page | at_most: paginate.items }} OF {{ paginate.items }} PIECES
      </p>
    </div>
  {%- endif -%}

    </div><!-- /.jnc-grid-col -->
  </div><!-- /.jnc-layout -->

  {%- endpaginate -%}

  <!-- ═══════════════════════════════════════════════════
       WHAT ARE THEY SAYING — TESTIMONIALS
       Rebuilt from a second live, direct examination of wearcomet.com's
       own collection-page testimonial carousel (Aug 2026): one full
       card per view under 750px, a peek of the next card from 750px up
       (Comet's own Swiper runs slidesPerView 1.1), photo at natural
       aspect ratio, bold quote-title + a separate body paragraph, name
       + optional verified badge, arrows clamped (non-looping) at both
       ends. Content lives in fixed numbered fields, one named group per
       real collection handle (testimonial_earrings_1-6,
       testimonial_necklaces_1-6, testimonial_bracelets_1-6,
       testimonial_best-sellers_1-6, testimonial_new-in_1-6) — no
       "blocks", so every collection shows its own independent set out
       of the box. Which group actually renders is resolved just below
       via a Collection-reference metafield
       (custom.testimonial_source_collection): if a collection points
       that field at another collection — picked from a native admin
       dropdown, never typed by hand — this section borrows that
       collection's group instead of its own. Falls back to the current
       collection's own handle when the metafield is blank.
  ═══════════════════════════════════════════════════ -->
  {%- assign testi_source_ref = collection.metafields.custom.testimonial_source_collection.value -%}
  {%- if testi_source_ref != blank -%}
    {%- assign testi_source_handle = testi_source_ref.handle -%}
  {%- else -%}
    {%- assign testi_source_handle = collection.handle -%}
  {%- endif -%}

  {%- assign jnc_testi_count = 0 -%}
  {%- for i in (1..6) -%}
    {%- assign t_title_key = 'testimonial_' | append: testi_source_handle | append: '_' | append: i | append: '_quote_title' -%}
    {%- assign t_name_key  = 'testimonial_' | append: testi_source_handle | append: '_' | append: i | append: '_name' -%}
    {%- if section.settings[t_title_key] != blank or section.settings[t_name_key] != blank -%}
      {%- assign jnc_testi_count = jnc_testi_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if jnc_testi_count > 0 -%}
  <section class="jnc-testimonials">
    <h2 class="jnc-testimonials-heading">{{ section.settings.testimonials_heading | default: 'WHAT ARE THEY SAYING' }}</h2>
    <div class="jnc-testimonials-viewport">
      <div class="jnc-testimonials-track-wrap">
        <div class="jnc-testimonials-tiles" id="jnc-testimonials-track">
          {%- for i in (1..6) -%}
            {%- assign t_photo_key = 'testimonial_' | append: testi_source_handle | append: '_' | append: i | append: '_photo' -%}
            {%- assign t_title_key = 'testimonial_' | append: testi_source_handle | append: '_' | append: i | append: '_quote_title' -%}
            {%- assign t_body_key  = 'testimonial_' | append: testi_source_handle | append: '_' | append: i | append: '_quote_body' -%}
            {%- assign t_name_key  = 'testimonial_' | append: testi_source_handle | append: '_' | append: i | append: '_name' -%}
            {%- assign t_badge_key = 'testimonial_' | append: testi_source_handle | append: '_' | append: i | append: '_show_badge' -%}
            {%- assign t_photo = section.settings[t_photo_key] -%}
            {%- assign t_title = section.settings[t_title_key] -%}
            {%- assign t_body  = section.settings[t_body_key]  -%}
            {%- assign t_name  = section.settings[t_name_key]  -%}
            {%- if t_title != blank or t_name != blank -%}
              <div class="jnc-testimonial-card">
                <div class="jnc-testi-photo-wrap">
                  {%- if t_photo != blank -%}
                    <img class="jnc-testi-photo" src="{{ t_photo | image_url: width: 900 }}" srcset="{{ t_photo | image_url: width: 450 }} 450w, {{ t_photo | image_url: width: 700 }} 700w, {{ t_photo | image_url: width: 900 }} 900w" sizes="(min-width: 768px) 48vw, 100vw" alt="{{ t_name | escape }}" loading="lazy" width="900" height="720">
                  {%- endif -%}
                </div>
                <div class="jnc-testi-body">
                  <div class="jnc-testi-stars" aria-hidden="true">★★★★★</div>
                  {%- if t_title != blank -%}
                    <h3 class="jnc-testi-title">{{ t_title }}</h3>
                  {%- endif -%}
                  {%- if t_body != blank -%}
                    <div class="jnc-testi-quote">{{ t_body }}</div>
                  {%- endif -%}
                  <div class="jnc-testi-name-row">
                    <span class="jnc-testi-name">{{ t_name }}</span>
                    {%- if section.settings[t_badge_key] -%}
                      <svg class="jnc-testi-badge" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="jnc-testimonials-arrows">
        <button class="jnc-testimonials-arrow" id="jnc-testi-prev" aria-label="Previous testimonial" type="button">&#8592;</button>
        <button class="jnc-testimonials-arrow" id="jnc-testi-next" aria-label="Next testimonial" type="button">&#8594;</button>
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ═══════════════════════════════════════════════════
       LOOKING FOR SOMETHING ELSE? CROSS-SELL STRIP
  ═══════════════════════════════════════════════════ -->

  {%- comment -%}
    Pass 1: count how many tiles have content (label OR link non-blank).
    This count drives data-tile-count (JS carousel).
  {%- endcomment -%}
  {%- assign jnc_cs_count = 0 -%}
  {%- for i in (1..6) -%}
    {%- assign cs_label_key = 'crosssell' | append: i | append: '_label' -%}
    {%- assign cs_link_key  = 'crosssell' | append: i | append: '_link'  -%}
    {%- if section.settings[cs_label_key] != blank or section.settings[cs_link_key] != blank -%}
      {%- assign jnc_cs_count = jnc_cs_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if jnc_cs_count > 0 -%}
  <div class="jnc-crosssell">
    <h2 class="jnc-crosssell-heading">LOOKING FOR SOMETHING ELSE?</h2>
    {%- comment -%}
      The desktop prev/next arrows are gone — the row is a native
      swipeable strip now (click-drag + trackpad + scrollbar). Mobile
      already was. {%- endcomment -%}
    <div class="jnc-crosssell-track-wrap">
      <div class="jnc-crosssell-tiles" id="jnc-crosssell-track" data-tile-count="{{ jnc_cs_count }}">

        {%- comment -%} Pass 2: render tiles whose label OR link is non-blank {%- endcomment -%}
        {%- for i in (1..6) -%}
          {%- assign cs_img_key   = 'crosssell' | append: i | append: '_image' -%}
          {%- assign cs_label_key = 'crosssell' | append: i | append: '_label' -%}
          {%- assign cs_link_key  = 'crosssell' | append: i | append: '_link'  -%}
          {%- assign cs_image = section.settings[cs_img_key]   -%}
          {%- assign cs_label = section.settings[cs_label_key] -%}
          {%- assign cs_link  = section.settings[cs_link_key]  -%}
          {%- if cs_label != blank or cs_link != blank -%}
            <a href="{{ cs_link | default: '/collections/all' }}"
               class="jnc-crosssell-tile"
               aria-label="Shop {{ cs_label }}">
              <div class="jnc-crosssell-tile-img">
                {%- if cs_image != blank -%}
                  <img src="{{ cs_image | image_url: width: 800 }}"
                       srcset="{{ cs_image | image_url: width: 400 }} 400w, {{ cs_image | image_url: width: 600 }} 600w, {{ cs_image | image_url: width: 800 }} 800w, {{ cs_image | image_url: width: 1000 }} 1000w"
                       sizes="(min-width: 768px) 25vw, 82vw"
                       alt="{{ cs_label | escape }}"
                       loading="lazy"
                       width="800" height="1000">
                {%- endif -%}
                {%- if cs_label != blank -%}
                  <span class="jnc-crosssell-tile-label">{{ cs_label }}</span>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}

      </div>
    </div>
  </div>
  {%- endif -%}

    <!-- ─── CART DRAWER + AVAILABLE OFFERS PANEL — moved to jn-header.liquid. See
       that file for the markup, styling, and base open/close JS. ── -->

<!-- ─── QUICK-ADD SIZE SHEET — opened from a product card's + / bag icon
       when that product has more than one variant. Picking an option adds
       it and opens the same drawer used everywhere else on this page. ── -->
  <div class="jnc-qa-overlay" id="jnc-qa-overlay"></div>
  <div class="jnc-qa-sheet" id="jnc-qa-sheet" role="dialog" aria-modal="true" aria-label="Select options">
    <!-- Grab handle: mobile-only affordance, hidden by CSS at >=768px. -->
