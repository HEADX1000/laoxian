</div><!-- /.jnc-page-root -->

<!-- ═══════════════════════════════════════════════════
     JAVASCRIPT
═══════════════════════════════════════════════════ -->
<script>
(function killDuplicates() {
  var root = document.querySelector('.jnc-page-root');
  if (!root) return;
  /* The generic <footer>-tag sweep and the .shopify-section-group-header-group /
     -footer-group entries used to live here too. Both were deleting JIINEVA's OWN
     real shared header/footer sections, not just Dawn's leftovers: the shared
     footer section renders a literal <footer> tag inside it, and the shared header
     section carries shopify-section-group-header-group on itself (confirmed live
     on jiineva.com) — so this function was removing them from the page on every
     load. Same bug, same fix already applied to the PDP's killDuplicates(). */
  var dawnSelectors = [
    '#shopify-section-footer',
    '#shopify-section-announcement-bar',
    '#shopify-section-header',
    '.footer',
    '.email-signup-banner',
    '.newsletter-section'
  ];
  dawnSelectors.forEach(function(sel) {
    document.querySelectorAll(sel).forEach(function(el) {
      if (!root.contains(el)) el.remove();
    });
  });
})();

(function() {
  'use strict';

    /* ─── SEARCH OVERLAY + predictive search ─── now consolidated in jn-header.liquid.
     Open/close, live suggestions, submitted results and recent-search history all live
     there now as one DOMContentLoaded block. jnpPushOverlay/jnpManualClose on this page
     still own the back-button / overlay-stack side so nothing changes behaviourally. */
  /* ─── NO-RESULTS: desktop arrow carousel (jnc-ymal pattern) ─── */
  var jnNoresGrid = document.getElementById('jn-nores-ymal-grid');
  var jnNoresPrev = document.getElementById('jn-nores-prev');
  var jnNoresNext = document.getElementById('jn-nores-next');
  if (jnNoresGrid && jnNoresPrev && jnNoresNext) {
    var jnNoresCardWidth = function() {
      var first = jnNoresGrid.querySelector('.jn-nores-ymal-card');
      return first ? first.offsetWidth + 1 : 300;
    };
    jnNoresNext.addEventListener('click', function() { jnNoresGrid.scrollBy({ left: jnNoresCardWidth(), behavior: 'smooth' }); });
    jnNoresPrev.addEventListener('click', function() { jnNoresGrid.scrollBy({ left: -jnNoresCardWidth(), behavior: 'smooth' }); });
    var jnUpdateNoresArrows = function() {
      var atStart = jnNoresGrid.scrollLeft <= 4;
      var atEnd   = jnNoresGrid.scrollLeft + jnNoresGrid.offsetWidth >= jnNoresGrid.scrollWidth - 4;
      jnNoresPrev.disabled = atStart;
      jnNoresNext.disabled = atEnd;
    };
    jnNoresGrid.addEventListener('scroll', jnUpdateNoresArrows, { passive: true });
    jnUpdateNoresArrows();
  }
  /* ─── NO-RESULTS: mobile swipe carousel (jnp-gil-mob-track pattern) ─── */
  var jnNoresMobTrack = document.getElementById('jn-nores-mob-track');
  if (jnNoresMobTrack) {
    var jnNoresCards   = Array.prototype.slice.call(jnNoresMobTrack.querySelectorAll('.jn-nores-mob-card'));
    var jnNoresCurrent = 0;
    var jnNoresTsX     = 0;
    var jnNoresSetActive = function(idx, instant) {
      if (!jnNoresCards.length) return;
      jnNoresCurrent = idx;
      jnNoresMobTrack.style.transition = instant ? 'none' : '';
      jnNoresMobTrack.style.transform = 'translateX(calc(-' + idx + ' * (82vw + 12px)))';
      if (instant) { jnNoresMobTrack.getBoundingClientRect(); jnNoresMobTrack.style.transition = ''; }
      jnNoresCards.forEach(function(c, i) { c.classList.toggle('jn-active', i === idx); });
    };
    jnNoresMobTrack.addEventListener('touchstart', function(e) { jnNoresTsX = e.touches[0].clientX; }, { passive: true });
    jnNoresMobTrack.addEventListener('touchend', function(e) {
      var d = jnNoresTsX - e.changedTouches[0].clientX;
      if (Math.abs(d) > 40) {
        var next, instant = false;
        if (d > 0) {
          if (jnNoresCurrent === jnNoresCards.length - 1) { instant = true; next = 0; }
          else { next = jnNoresCurrent + 1; }
        } else {
          if (jnNoresCurrent === 0) { instant = true; next = jnNoresCards.length - 1; }
          else { next = jnNoresCurrent - 1; }
        }
        jnNoresSetActive(next, instant);
      }
    }, { passive: true });
  }

  /* ─── HAMBURGER ─── now lives in jn-header.liquid (self-contained,
     wires up #jn-hamburger/#jn-mobile-menu right where it renders them). ── */

  /* ===================================================================
     FILTER + SORT ENGINE
     ===================================================================
     One engine behind four controls: the subcategory row above the grid,
     SORT BY, COLOUR, and CLEAR. It filters and sorts the cards that are
     already on the page - no reload, no refetch, no re-render of markup,
     which is what makes it feel instant.

     TWO SHAPES, ONE STATE
     Desktop chooses and applies in the same gesture, because the grid is
     right there to see change. Mobile STAGES instead: the panel covers the
     screen, so applying as you tap would mean tapping blind - the live
     "SEE RESULTS (n)" count tells you what you would get, and nothing
     behind the panel moves until you commit. jncState is what the grid is
     showing; jncStaged is what the panel is showing. On desktop they are
     the same object by definition (jncLive returns jncState), so there is
     no second code path to keep in sync.

     WHAT IT DOES NOT CLAIM
     It can only order and hide what the server already sent, i.e. this
     paginated page. On a collection big enough to paginate, a colour
     filter therefore narrows the pieces loaded so far, and LOAD MORE
     carries the active filter into page 2 rather than dropping it.
     =================================================================== */
  var jncLayout    = document.getElementById('jnc-layout');
  var jncGrid      = document.getElementById('jnc-grid');
  var jncFilterbar = document.getElementById('jnc-filterbar');

  if (jncLayout && jncGrid) {
    var jncToggle       = document.getElementById('jnc-filter-toggle');
    var jncToggleLabel  = document.getElementById('jnc-filter-toggle-label');
    var jncPanel        = document.getElementById('jnc-filter-panel');
    var jncPanelClose   = document.getElementById('jnc-fpanel-close');
    var jncApply        = document.getElementById('jnc-fapply');
    var jncClearD       = document.getElementById('jnc-fclear-d');
    var jncClearM       = document.getElementById('jnc-fclear-m');
    var jncCountEl      = document.getElementById('jnc-filter-count');
    var jncNoRes        = document.getElementById('jnc-noresults');
    var jncNoResClear   = document.getElementById('jnc-noresults-clear');
    var jncColorNEl     = document.getElementById('jnc-fsection-n-color');
    var jncPagInfo      = jncLayout.querySelector('.jnc-pagination-info');
    var jncLoadMore     = document.getElementById('jnc-load-more');

    var jncCards     = [].slice.call(jncGrid.querySelectorAll('.jn-product-card'));
    var jncFillers   = [].slice.call(jncGrid.querySelectorAll('.jnc-blank-filler'));
    var jncSortOpts  = jncPanel ? [].slice.call(jncPanel.querySelectorAll('.jnc-fopt[data-sort]')) : [];
    var jncColorOpts = jncPanel ? [].slice.call(jncPanel.querySelectorAll('.jnc-fopt[data-color]')) : [];
    var jncHeads     = jncPanel ? [].slice.call(jncPanel.querySelectorAll('.jnc-fsection-head')) : [];

    /* An empty collection has nothing to filter, and a dead FILTER button
       is worse than no button, so the bar comes off the page entirely. */
    if (jncCards.length === 0) {
      if (jncFilterbar) jncFilterbar.style.display = 'none';
      if (jncLayout) jncLayout.classList.remove('is-open');
    } else {

    /* The DOM order the server sent IS "popular": the collection's own
       manual / default sort, whatever the merchant arranged in admin.
       Recorded once, up front, because the engine reorders the DOM and
       could not recover it afterwards. Doubles as the tie-breaker for
       every other sort, so equal prices never shuffle at random. */
    jncCards.forEach(function(c, i) { c.setAttribute('data-i', i); });

    var jncState  = { sort: 'popular', colors: [], sub: '', subType: '' };
    var jncStaged = { sort: 'popular', colors: [] };
    var jncPushedHistory = false;
    var jncBestOrder = null, jncBestPromise = null;

    function jncIsMobile() { return window.matchMedia('(max-width: 767px)').matches; }
    /* The object the PANEL is currently editing. */
    function jncLive() {
      return (jncIsMobile() && jncLayout.classList.contains('is-open')) ? jncStaged : jncState;
    }
    function jncTrim(t) { return (t || '').replace(/^\s+|\s+$/g, ''); }

    /* ---- matching ---------------------------------------------------- */
    function jncCardColors(card) {
      var raw = card.getAttribute('data-colors') || '';
      if (!raw) return [];
      var out = raw.toLowerCase().split('|');
      for (var i = 0; i < out.length; i++) out[i] = jncTrim(out[i]);
      return out;
    }
    function jncMatchesSub(card) {
      var sub = jncState.sub;
      if (!sub) return true;
      if (jncState.subType === 'collection') {
        var colls = (card.getAttribute('data-collections') || '').toLowerCase().split(',');
        for (var i = 0; i < colls.length; i++) { if (jncTrim(colls[i]) === sub) return true; }
        return false;
      }
      return (card.getAttribute('data-category') || '').toLowerCase() === sub;
    }
    function jncMatchesColors(card, colors) {
      if (!colors.length) return true;              /* nothing picked = everything */
      var mine = jncCardColors(card);
      for (var i = 0; i < colors.length; i++) { if (mine.indexOf(colors[i]) !== -1) return true; }
      return false;                                  /* OR within the facet, as every store does it */
    }
    function jncCountFor(colors) {
      var n = 0;
      jncCards.forEach(function(c) { if (jncMatchesSub(c) && jncMatchesColors(c, colors)) n++; });
      return n;
    }

    /* ---- sorting ------------------------------------------------------ */
    function jncNum(el, attr) { var v = parseInt(el.getAttribute(attr), 10); return isNaN(v) ? 0 : v; }
    function jncOrig(el) { return jncNum(el, 'data-i'); }
    function jncSorted(list, sort) {
      var arr = list.slice();
      if (sort === 'new') {
        arr.sort(function(a, b) { return (jncNum(b, 'data-created') - jncNum(a, 'data-created')) || (jncOrig(a) - jncOrig(b)); });
      } else if (sort === 'price-asc') {
        arr.sort(function(a, b) { return (jncNum(a, 'data-price') - jncNum(b, 'data-price')) || (jncOrig(a) - jncOrig(b)); });
      } else if (sort === 'price-desc') {
        arr.sort(function(a, b) { return (jncNum(b, 'data-price') - jncNum(a, 'data-price')) || (jncOrig(a) - jncOrig(b)); });
      } else if (sort === 'best' && jncBestOrder) {
        arr.sort(function(a, b) {
          var ai = jncBestOrder[a.getAttribute('data-handle')];
          var bi = jncBestOrder[b.getAttribute('data-handle')];
          if (ai === undefined) ai = 99999;
          if (bi === undefined) bi = 99999;
          return (ai - bi) || (jncOrig(a) - jncOrig(b));
        });
      } else {
        arr.sort(function(a, b) { return jncOrig(a) - jncOrig(b); });
      }
      return arr;
    }

    /* BEST SELLING cannot be worked out here: Liquid has no sales figures
       and the browser has none either. Shopify does, though, so this asks
       it for the same collection sorted that way and keeps only the ORDER
       of handles - one request, lazily, the first time anyone picks it,
       then cached for the rest of the visit. section_id makes Shopify
       return this section alone rather than the whole page. If it fails
       for any reason the catch stores an empty map, which makes every
       handle tie and the original order stand - the sort quietly does
       nothing instead of the page breaking. */
    function jncEnsureBest() {
      if (jncBestOrder) return Promise.resolve(jncBestOrder);
      if (jncBestPromise) return jncBestPromise;
      var base = {{ collection.url | json }} || window.location.pathname;
      var url  = base + '?sort_by=best-selling&section_id=' + encodeURIComponent({{ section.id | json }});
      jncBestPromise = fetch(url, { headers: { 'Accept': 'text/html' } })
        .then(function(r) { if (!r.ok) throw new Error('status ' + r.status); return r.text(); })
        .then(function(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var cards = doc.querySelectorAll('.jn-product-card[data-handle]');
          var order = {};
          for (var i = 0; i < cards.length; i++) {
            var h = cards[i].getAttribute('data-handle');
            if (h && order[h] === undefined) order[h] = i;
          }
          jncBestOrder = order;
          return order;
        })
        .catch(function(err) {
          console.warn('[JIINEVA] best-selling order unavailable; keeping current order', err);
          jncBestOrder = {};
          return jncBestOrder;
        });
      return jncBestPromise;
    }

    /* ---- render ------------------------------------------------------- */
    function jncCols() { return window.matchMedia('(min-width: 768px)').matches ? 4 : 2; }
    var jncColsNow = jncCols();

    function jncRender() {
      var visible = [], hidden = [];
      jncCards.forEach(function(c) {
        if (jncMatchesSub(c) && jncMatchesColors(c, jncState.colors)) visible.push(c);
        else hidden.push(c);
      });
      hidden.forEach(function(c) { c.style.display = 'none'; });
      visible.forEach(function(c) { c.style.display = ''; });

      /* Fillers keep the last row square at 2-up and 4-up. The count has
         to be recomputed on every filter, not left at whatever Liquid
         rendered for the unfiltered page, or filtering leaves a stale
         white square sitting in the grid. */
      var need = visible.length ? (jncCols() - (visible.length % jncCols())) % jncCols() : 0;
      while (jncFillers.length < 3) {
        var f = document.createElement('div');
        f.className = 'jnc-blank-filler';
        f.setAttribute('role', 'presentation');
        f.setAttribute('aria-hidden', 'true');
        jncFillers.push(f);
      }
      jncFillers.forEach(function(el, i) { el.classList.toggle('jnc-off', i >= need); });

      /* One reflow for the whole regrouping: order the matches, park the
         non-matches after them, fillers last. Moving the real nodes (rather
         than faking it with CSS order) keeps tab order and screen-reader
         order honest, and moving an <img> within the same document never
         refetches it. */
      var frag = document.createDocumentFragment();
      jncSorted(visible, jncState.sort).forEach(function(c) { frag.appendChild(c); });
      hidden.forEach(function(c) { frag.appendChild(c); });
      jncFillers.forEach(function(el) { frag.appendChild(el); });
      jncGrid.appendChild(frag);

      var n = visible.length;
      if (jncCountEl) jncCountEl.textContent = (n === 1) ? '1 PIECE' : (n + ' PIECES');

      var narrowed = jncState.colors.length > 0;
      if (jncFilterbar) jncFilterbar.classList.toggle('is-filtered', narrowed || jncState.sort !== 'popular');
      jncLayout.classList.toggle('is-filtered', narrowed);
      if (jncNoRes) jncNoRes.classList.toggle('is-on', n === 0);
      jncGrid.style.display = (n === 0) ? 'none' : '';
      if (jncPagInfo) jncPagInfo.style.display = narrowed ? 'none' : '';
    }

    /* ---- panel UI ----------------------------------------------------- */
    var JNC_SWATCH = {
      'gold': '#D4AF37', 'yellow gold': '#D4AF37', '18k gold': '#D4AF37', '14k gold': '#D4AF37',
      '22k gold': '#D4AF37', '9k gold': '#D9BE6A',
      'rose gold': '#B76E79', 'rose': '#B76E79', 'pink gold': '#B76E79',
      'white gold': '#E6E6E6', 'silver': '#C0C0C0', 'sterling silver': '#C0C0C0',
      'platinum': '#E5E4E2', 'oxidised': '#4A4A4A', 'oxidized': '#4A4A4A', 'gunmetal': '#4A4A4A',
      'black': '#1a1a1a', 'white': '#FFFFFF', 'ivory': '#FFFFF0', 'cream': '#FFFDD0',
      'pearl': '#F6F2E8', 'beige': '#E8DCC8', 'nude': '#E3C4A8',
      'bronze': '#CD7F32', 'copper': '#B87333', 'brown': '#6D4C41',
      'grey': '#9E9E9E', 'gray': '#9E9E9E', 'red': '#C0392B', 'maroon': '#7B1E1E',
      'pink': '#E8A0BF', 'purple': '#7D3C98', 'lavender': '#C3B1E1',
      'blue': '#2D5BA3', 'navy': '#1F3864', 'sky blue': '#87CEEB', 'turquoise': '#40E0D0',
      'green': '#2E7D32', 'emerald': '#046307', 'olive': '#6B7A3A',
      'yellow': '#F4C430', 'orange': '#E67E22', 'peach': '#FFCBA4',
      'ruby': '#9B111E', 'sapphire': '#0F52BA', 'amethyst': '#9966CC', 'topaz': '#FFC87C',
      'clear': '#F2F6F8', 'crystal': '#F2F6F8', 'transparent': '#F2F6F8'
    };
    var JNC_SWATCH_MIX = {
      'multi': 1, 'multicolour': 1, 'multicolor': 1, 'multi colour': 1, 'multi color': 1,
      'two tone': 1, 'two-tone': 1, 'dual tone': 1, 'dual-tone': 1, 'mixed': 1, 'assorted': 1
    };
    /* Painted from the option's own value, so a colour nobody anticipated
       still gets a chip: known jewellery finishes first, then any name the
       browser itself understands as a CSS colour, then a neutral chip.
       Never a missing square, never a wrong-looking one. */
    function jncPaintSwatches() {
      jncColorOpts.forEach(function(btn) {
        var sw = btn.querySelector('.jnc-fswatch');
        if (!sw) return;
        var name = (btn.getAttribute('data-color') || '').toLowerCase().replace(/^\s+|\s+$/g, '');
        if (JNC_SWATCH_MIX[name]) {
          sw.style.background = 'linear-gradient(135deg, #D4AF37 0 50%, #C0C0C0 50% 100%)';
          return;
        }
        if (JNC_SWATCH[name]) { sw.style.background = JNC_SWATCH[name]; return; }
        sw.style.background = '';
        sw.style.background = name;
        if (!sw.style.background) sw.style.background = '#E0E0E0';
      });
    }

    function jncSyncClearState() {
      var st = jncLive();
      var active = (st.colors.length > 0) || (st.sort !== 'popular');
      if (jncClearD) jncClearD.disabled = !active;
      if (jncClearM) jncClearM.disabled = !active;
    }

    function jncSyncOptionUi() {
      var st = jncLive();
      jncSortOpts.forEach(function(b) {
        var on = b.getAttribute('data-sort') === st.sort;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      jncColorOpts.forEach(function(b) {
        var v  = (b.getAttribute('data-color') || '').toLowerCase();
        var on = st.colors.indexOf(v) !== -1;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        /* A value with nothing behind it in the current subcategory is
           struck through rather than removed - the list must not reshuffle
           under a finger that is already moving toward a row. An already
           chosen value is never struck through, or turning it off would
           become impossible. */
        var avail = 0;
        jncCards.forEach(function(c) { if (jncMatchesSub(c) && jncCardColors(c).indexOf(v) !== -1) avail++; });
        var dead = (avail === 0) && !on;
        b.classList.toggle('is-empty', dead);
        b.disabled = dead;
      });
      if (jncColorNEl) jncColorNEl.textContent = st.colors.length ? (' (' + st.colors.length + ')') : '';
      if (jncApply) {
        /* Button text + enabled state track the count live. 0 flips it to
           the "NO RESULTS" treatment (greyed, un-pressable); any positive
           count shows "SEE RESULTS (n)" and re-enables. CLEAR is always
           clickable while any filter is on (handled in jncSyncClearState
           below), so the shopper always has a way out of an empty set. */
        var jncN = jncCountFor(st.colors);
        if (jncN === 0) {
          jncApply.textContent = 'NO RESULTS';
          jncApply.disabled = true;
          jncApply.setAttribute('aria-disabled', 'true');
        } else {
          jncApply.textContent = 'SEE RESULTS (' + jncN + ')';
          jncApply.disabled = false;
          jncApply.removeAttribute('aria-disabled');
        }
      }
      jncSyncClearState();
    }

    /* ---- accordion ---------------------------------------------------- */
    function jncBodyOf(head) { return document.getElementById(head.getAttribute('aria-controls')); }
    function jncOpenSection(head, animate) {
      var body = jncBodyOf(head); if (!body) return;
      head.setAttribute('aria-expanded', 'true');
      body.setAttribute('aria-hidden', 'false');
      if (!animate) {
        body.style.transition = 'none';
        body.style.height = 'auto';
        void body.offsetHeight;
        body.style.transition = '';
        return;
      }
      var inner = body.firstElementChild;
      body.style.height = (inner ? inner.scrollHeight : 0) + 'px';
      /* height settles to auto once the animation is done, so a later
         resize or font swap can never clip the last option off. */
      var done = function(e) {
        if (e.target !== body || e.propertyName !== 'height') return;
        body.removeEventListener('transitionend', done);
        if (head.getAttribute('aria-expanded') === 'true') body.style.height = 'auto';
      };
      body.addEventListener('transitionend', done);
    }
    function jncCloseSection(head) {
      var body = jncBodyOf(head); if (!body) return;
      /* auto -> 0 does not animate, so the measured height is pinned first
         (with the transition off for that one frame), then released. */
      var h = body.scrollHeight;
      body.style.transition = 'none';
      body.style.height = h + 'px';
      void body.offsetHeight;
      body.style.transition = '';
      head.setAttribute('aria-expanded', 'false');
      body.setAttribute('aria-hidden', 'true');
      body.style.height = '0px';
    }
    jncHeads.forEach(function(head) {
      jncOpenSection(head, false);
      head.addEventListener('click', function() {
        if (head.getAttribute('aria-expanded') === 'true') jncCloseSection(head);
        else jncOpenSection(head, true);
      });
    });

    /* ---- open / close ------------------------------------------------- */
    function jncOpenPanel() {
      jncLayout.classList.add('is-open');
      if (jncToggle) jncToggle.setAttribute('aria-expanded', 'true');
      if (jncIsMobile()) {
        /* Start staging from what the grid is actually showing. */
        jncStaged = { sort: jncState.sort, colors: jncState.colors.slice() };
        if (window.jnLockBodyScroll) window.jnLockBodyScroll();
        if (window.jnpPushOverlay) { window.jnpPushOverlay('filter'); jncPushedHistory = true; }
      } else if (jncToggleLabel) {
        jncToggleLabel.textContent = 'HIDE';
      }
      jncSyncOptionUi();
    }
    /* Plain close. Staged choices are dropped on purpose: the grid behind
       never moved, so closing leaves the page exactly as it looked - no
       half-applied state, nothing silently remembered. SEE RESULTS is the
       only thing that commits. */
    function jncClosePanel() {
      jncPushedHistory = false;
      jncLayout.classList.remove('is-open');
      if (jncToggle) jncToggle.setAttribute('aria-expanded', 'false');
      if (jncToggleLabel) jncToggleLabel.textContent = 'FILTER';
      jncStaged = { sort: jncState.sort, colors: jncState.colors.slice() };
      jncSyncOptionUi();
      if (window.jnpMaybeUnlockScroll) window.jnpMaybeUnlockScroll();
    }
    window.jncCloseFilterPanel = jncClosePanel;
    /* Dismissal goes through the shared overlay stack whenever this panel
       put an entry on it, so the Android back gesture closes the filter
       instead of leaving the collection - the same contract the cart
       drawer and the size sheet already follow. */
    function jncDismissPanel() {
      if (jncPushedHistory && window.jnpManualClose) window.jnpManualClose('filter');
      else jncClosePanel();
    }
    function jncCommit() {
      jncState.sort   = jncStaged.sort;
      jncState.colors = jncStaged.colors.slice();
      jncRender();
      if (jncState.sort === 'best') jncEnsureBest().then(jncRender);
      jncSyncUrl();
    }

    /* ---- URL ----------------------------------------------------------
       Written with replaceState, never pushState: a filter is not a page,
       and pushing one entry per tap would turn the back button into an
       undo stack that the shopper has to climb out of to leave. Reloading
       or sharing the link still restores the exact view. */
    function jncSyncUrl() {
      if (!window.URLSearchParams || !history.replaceState) return;
      var p = new URLSearchParams(window.location.search);
      if (jncState.colors.length) p.set('color', jncState.colors.join(',')); else p.delete('color');
      if (jncState.sort !== 'popular') p.set('sort', jncState.sort); else p.delete('sort');
      var q = p.toString();
      history.replaceState(history.state, '', window.location.pathname + (q ? '?' + q : '') + window.location.hash);
    }
    function jncReadUrl() {
      if (!window.URLSearchParams) return;
      var p = new URLSearchParams(window.location.search);
      var c = p.get('color');
      if (c) {
        c.split(',').forEach(function(raw) {
          var v = jncTrim(raw).toLowerCase();
          if (!v || jncState.colors.indexOf(v) !== -1) return;
          /* Only values that exist as options here are honoured, so a
             stale or hand-edited link cannot filter the grid down to
             nothing with no visible reason why. */
          for (var i = 0; i < jncColorOpts.length; i++) {
            if ((jncColorOpts[i].getAttribute('data-color') || '').toLowerCase() === v) { jncState.colors.push(v); return; }
          }
        });
      }
      var s = p.get('sort');
      if (s && ['popular', 'new', 'best', 'price-asc', 'price-desc'].indexOf(s) !== -1) jncState.sort = s;
    }

    /* ---- wiring ------------------------------------------------------- */
    if (jncToggle) {
      jncToggle.addEventListener('click', function() {
        if (jncLayout.classList.contains('is-open')) jncDismissPanel();
        else jncOpenPanel();
      });
    }
    if (jncPanelClose) jncPanelClose.addEventListener('click', jncDismissPanel);
    if (jncApply) jncApply.addEventListener('click', function() { jncCommit(); jncDismissPanel(); });

    jncSortOpts.forEach(function(b) {
      b.addEventListener('click', function() {
        var st = jncLive();
        st.sort = b.getAttribute('data-sort');
        jncSyncOptionUi();
        if (st.sort === 'best') jncEnsureBest().then(function() { if (jncState.sort === 'best') jncRender(); });
        if (st === jncState) { jncRender(); jncSyncUrl(); }
      });
    });
    jncColorOpts.forEach(function(b) {
      b.addEventListener('click', function() {
        if (b.disabled) return;
        var v  = (b.getAttribute('data-color') || '').toLowerCase();
        var st = jncLive();
        var i  = st.colors.indexOf(v);
        if (i === -1) st.colors.push(v); else st.colors.splice(i, 1);
        jncSyncOptionUi();
        if (st === jncState) { jncRender(); jncSyncUrl(); }
      });
    });
    function jncClearAll() {
      var st = jncLive();
      st.colors = [];
      st.sort = 'popular';
      jncSyncOptionUi();
      if (st === jncState) { jncRender(); jncSyncUrl(); }
    }
    if (jncClearD) jncClearD.addEventListener('click', jncClearAll);
    if (jncClearM) jncClearM.addEventListener('click', jncClearAll);
    /* The empty state's own button clears what is APPLIED - it is behind
       the panel, so there is nothing staged to clear. */
    if (jncNoResClear) {
      jncNoResClear.addEventListener('click', function() {
        jncState.colors = [];
        jncState.sort = 'popular';
        jncStaged = { sort: 'popular', colors: [] };
        jncSyncOptionUi();
        jncRender();
        jncSyncUrl();
      });
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && jncLayout.classList.contains('is-open')) jncDismissPanel();
    });

    /* The mobile panel lives on its own history entry so the back gesture
       closes the filter instead of leaving the collection. Popping that
       entry also restores the URL it was created with — which would throw
       away the parameters SEE RESULTS had just written a moment earlier,
       and a committed filter would vanish from the address bar (caught in
       testing: the grid was filtered, the URL was clean, and a refresh
       silently undid the shopper's choice). Re-asserting them once the pop
       has landed keeps the two in step, and is a harmless no-op for every
       other overlay's back press. */
    window.addEventListener('popstate', function() { setTimeout(jncSyncUrl, 0); });

    /* SUBCATEGORY ROW - same engine, so a subcategory and a colour
       combine instead of overwriting each other. Only <button> pills are
       wired: the top-level EARRINGS / NECKLACES / BRACELETS entries (and
       any Customize "Filter Pill" blocks) are real links to their own
       collection pages and must stay ordinary navigation. */
    var jncPills = [].slice.call(document.querySelectorAll('button.jnc-fpill'));
    jncPills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        jncPills.forEach(function(p) { p.classList.remove('jnc-fpill--active'); });
        pill.classList.add('jnc-fpill--active');
        var f = pill.getAttribute('data-filter');
        jncState.sub     = (!f || f === 'all') ? '' : f.toLowerCase();
        jncState.subType = pill.getAttribute('data-filter-type') || '';
        jncRender();
        jncSyncOptionUi();
      });
    });

    /* Arrows for the subcategory row, shown only when it really overflows. */
    [].slice.call(document.querySelectorAll('.jnc-subrow')).forEach(function(row) {
      var track = row.querySelector('.jnc-filter-pills-wrap');
      var prev  = row.querySelector('.jnc-subrow-arrow--prev');
      var next  = row.querySelector('.jnc-subrow-arrow--next');
      if (!track || !prev || !next) return;
      function sync() {
        var over = track.scrollWidth - track.clientWidth > 2;
        row.classList.toggle('has-overflow', over);
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
      }
      function step(dir) { track.scrollBy({ left: dir * Math.max(120, track.clientWidth * 0.6), behavior: 'smooth' }); }
      prev.addEventListener('click', function() { step(-1); });
      next.addEventListener('click', function() { step(1); });
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      window.addEventListener('load', sync);
      sync();
    });

    /* LOAD MORE keeps the filter. Built from the href the server rendered,
       stored once, so repeated clicks can never stack parameters. */
    if (jncLoadMore) {
      var jncLoadMoreHref = jncLoadMore.getAttribute('href') || '';
      jncLoadMore.addEventListener('click', function() {
        if (!jncLoadMoreHref) return;
        var u = jncLoadMoreHref.split('#')[0];
        var extra = [];
        if (jncState.colors.length) extra.push('color=' + encodeURIComponent(jncState.colors.join(',')));
        if (jncState.sort !== 'popular') extra.push('sort=' + encodeURIComponent(jncState.sort));
        if (extra.length) jncLoadMore.setAttribute('href', u + (u.indexOf('?') === -1 ? '?' : '&') + extra.join('&'));
      });
    }

    /* Sticky offsets, measured rather than guessed - see the note on
       .jnc-filterbar / .jnc-filter-panel in the <style> block above. */
    function jncSyncStickOffsets() {
      var nav  = document.querySelector('.jn-nav');
      var navH = nav ? Math.round(nav.getBoundingClientRect().height) : 56;
      /* The sticky subrow sits directly below the nav. Its height has to
         be folded into every offset below it, or the filter bar overlaps
         it. Measured off the LIVE element rather than hardcoded, so the
         figure is right at mobile (shorter row), desktop (taller row), and
         under any custom font-size override; zero on pages where the row
         didn't render (a collection with no subcategory metafield), and
         zero while the row is tucked (see jncScrollTuck below). */
      var sub  = document.querySelector('.jnc-subrow');
      var subVisible = (sub && getComputedStyle(sub).display !== 'none' && !document.getElementById('jnc-stickybar') ||
                       (sub && document.getElementById('jnc-stickybar') && !document.getElementById('jnc-stickybar').classList.contains('is-tucked')));
      var subH = subVisible ? Math.round(sub.getBoundingClientRect().height) : 0;
      var barH = jncFilterbar ? Math.round(jncFilterbar.getBoundingClientRect().height) : 46;
      var root = document.documentElement;
      root.style.setProperty('--jnc-nav-h', navH + 'px');
      root.style.setProperty('--jnc-subrow-h', subH + 'px');
      root.style.setProperty('--jnc-filterbar-h', barH + 'px');
      /* Filter bar sits at nav + subrow; the panel below sits at
         nav + subrow + filter bar + a small gap. When the subrow is
         tucked these shrink by the subrow's height on their own. */
      root.style.setProperty('--jnc-stick-top', (navH + subH) + 'px');
      root.style.setProperty('--jnc-panel-top', (navH + subH + barH + 16) + 'px');
    }
    jncSyncStickOffsets();
    window.addEventListener('resize', jncSyncStickOffsets);
    window.addEventListener('load', jncSyncStickOffsets);

    /* ═══ SCROLL-DIRECTION AWARE TOP BAND ═══════════════════════
       The reference's mobile page tucks the subcategory row up and out
       of the way on scroll down (only FILTER stays pinned), and rolls it
       back out on scroll up. This mirrors that: height collapses to 0
       with a smooth 0.28s ease on scroll down, restores on scroll up.
       Works on every width so a resized desktop window behaves the same
       as a phone.

       Pinned behaviour:
         - near the top of the page (y < threshold): always expanded, no
           matter what way the finger is going — you can never hit the
           top with the row still tucked.
         - scrolling DOWN past the threshold: tuck.
         - scrolling UP: untuck.

       dyGate ignores sub-pixel scroll jitter from the browser rounding
       so the row doesn't flicker. One rAF-batched handler = no layout
       thrashing even on a 120Hz phone. ═════════════════════════════════════ */
    var jncStickyEl = document.getElementById('jnc-stickybar');
    var jncSubrowEl = jncStickyEl ? jncStickyEl.querySelector('.jnc-subrow') : null;
    if (jncStickyEl && jncSubrowEl) {
      /* Pin the subrow's natural height to a pixel value so the collapse
         transition (height -> 0) has a defined "from" value. Written as a
         CSS custom property on the element rather than inline height —
         the .is-tucked override below targets this property's own rule,
         not an inline declaration, so toggling the class actually wins.
         Re-measured on resize since the row's height can change with
         viewport width (gap and padding steps). */
      function jncPinSubrowHeight() {
        var wasTucked = jncStickyEl.classList.contains('is-tucked');
        if (wasTucked) jncStickyEl.classList.remove('is-tucked');
        jncSubrowEl.style.removeProperty('--jnc-subrow-pinned-h');
        var h = jncSubrowEl.offsetHeight;
        jncSubrowEl.style.setProperty('--jnc-subrow-pinned-h', h + 'px');
        if (wasTucked) jncStickyEl.classList.add('is-tucked');
      }
      jncPinSubrowHeight();
      window.addEventListener('resize', jncPinSubrowHeight);
      window.addEventListener('load', jncPinSubrowHeight);

      /* ══ VELOCITY-GATED ANCHOR ═══════════════════════════════════════════
         The earlier time-window scheme untucked on slow desktop upscrolls
         but then re-tucked the moment Chrome's wheel-smoothing tail
         bumped scrollY back down by a few pixels — the net delta over
         the window jumped the other threshold, flipped the state, and
         started the opposite animation on top of the first. That's the
         jitter.

         Two independent gates stop that cold:

           (1) An anchor that tracks the deepest point reached while
               tucked / the highest point reached while untucked, and
               only flips the state when the user has travelled DIST_PX
               past it in the opposite direction. Unlike the time
               window, this NEVER resets to zero in the middle of a slow
               scroll — the anchor sits still while the user is
               approaching the threshold, so a slow consistent
               direction always eventually reaches it, however long it
               takes.

           (2) A smoothed scroll velocity (exponential moving average of
               per-frame dy/dt). A flip is only committed when velocity
               is going in the SAME direction as the anchor's net
               delta. A smoothing-tail bounce has instantaneous velocity
               opposite to the user's gesture — so even if the
               anchor's distance condition briefly matches, the
               velocity condition doesn't, and the state stays put.

         Numbers tuned against the real complaint — Chrome's wheel
         smoothing tail is up to about 15 px with instantaneous velocity
         briefly 300 px/sec. DIST_PX = 50 is bigger than that bounce,
         VEL_PX_SEC = 90 is small enough that an actual deliberate
         scroll (finger on scrollbar at ~150 px/sec) still flips the
         state cleanly. ══════════════════════════════════════════════════════ */
      var jncTuckEnableY = 80;
      var jncDistPx = 50;
      var jncVelPxSec = 90;
      var jncScrollAnchor = window.scrollY || 0;
      var jncLastY = jncScrollAnchor;
      var jncLastT = Date.now();
      var jncVelocity = 0;
      var jncScrollTickScheduled = false;

      function jncScrollTick() {
        var y = window.scrollY || 0;
        var now = Date.now();
        var dy = y - jncLastY;
        var dt = Math.max(1, now - jncLastT);
        /* EMA, 0.7 weight on history. Converges in ~5 frames to a
           stable per-second rate without being hair-trigger sensitive
           to a single frame's bump. */
        var instVel = dy / dt * 1000;
        jncVelocity = jncVelocity * 0.7 + instVel * 0.3;
        jncLastY = y;
        jncLastT = now;

        var isTucked = jncStickyEl.classList.contains('is-tucked');
        var was = isTucked;

        if (y < jncTuckEnableY) {
          if (isTucked) jncStickyEl.classList.remove('is-tucked');
          jncScrollAnchor = y;
        } else if (!isTucked) {
          /* Untucked: anchor tracks the HIGHEST point on the page we
             have been to (lowest scrollY). A real downward sweep past
             the distance threshold, confirmed by a positive smoothed
             velocity, tucks it. */
          if (y < jncScrollAnchor) {
            jncScrollAnchor = y;
          } else if (y - jncScrollAnchor >= jncDistPx && jncVelocity > jncVelPxSec) {
            jncStickyEl.classList.add('is-tucked');
            jncScrollAnchor = y;
          }
        } else {
          /* Tucked: anchor tracks the DEEPEST point (highest scrollY). A
             real upward sweep past the distance threshold, confirmed by
             a negative smoothed velocity, rolls it back out. */
          if (y > jncScrollAnchor) {
            jncScrollAnchor = y;
          } else if (jncScrollAnchor - y >= jncDistPx && jncVelocity < -jncVelPxSec) {
            jncStickyEl.classList.remove('is-tucked');
            jncScrollAnchor = y;
          }
        }

        if (was !== jncStickyEl.classList.contains('is-tucked')) {
          setTimeout(jncSyncStickOffsets, 300);
        }
        jncScrollTickScheduled = false;
      }
      window.addEventListener('scroll', function() {
        if (!jncScrollTickScheduled) {
          jncScrollTickScheduled = true;
          requestAnimationFrame(jncScrollTick);
        }
      }, { passive: true });
    }

    /* Crossing the 768px line swaps the panel between sidebar and
       takeover, and swaps 4-up for 2-up. Closing it first is deliberate:
       a takeover that becomes a sidebar mid-gesture would otherwise leave
       the body scroll-locked with nothing covering the screen. */
    window.addEventListener('resize', function() {
      var c = jncCols();
      if (c === jncColsNow) return;
      jncColsNow = c;
      if (jncLayout.classList.contains('is-open')) jncDismissPanel();
      jncRender();
    });

    /* ---- boot --------------------------------------------------------- */
    jncPaintSwatches();
    jncReadUrl();
    jncStaged = { sort: jncState.sort, colors: jncState.colors.slice() };
    jncSyncOptionUi();
    jncRender();
    if (jncState.sort === 'best') jncEnsureBest().then(jncRender);

    }
  }

  /* ─── ADD TO CART (shared) — posts one variant, refreshes the nav badge +
     the drawer's cart list, opens the drawer. Used by both the direct
     single-variant path below and the quick-add size sheet. Never touches
     .textContent on a caller's button (original bug: wipes the SVG icon
     since these buttons have no text nodes) — only toggles .is-adding. ── */
  function addVariantToCart(variantId, btn) {
    if (btn) btn.classList.add('is-adding');
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function(r) { if (!r.ok) throw new Error(r.statusText); return r.json(); })
    .then(function() { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }); })
    .then(function(r) { return r.json(); })
    .then(function(cart) {
      /* Keep label as "CART" — count lives INSIDE the bag icon on desktop and on
         top-right of the mobile menu cart icon. Delegates to the header's own
         updater so the count stays in sync across adds AND removes.
         The old unguarded jnUpdateCartBadge(cart.item_count) call that sat here
         was a stale reference to a never-defined function — a ReferenceError
         thrown by it broke the whole promise chain, which is exactly why the
         drawer wasn't opening after add-to-cart on the collection page (and why
         the size sheet didn't close after a size pick either). Removed. */
      if (window.jnUpdateHeaderCartCount) window.jnUpdateHeaderCartCount(cart.item_count);
      jnRenderDrawerCart(cart);
      window.jnpOpenDrawer();
      return cart;
    })
    .catch(function(err) { console.error('[JIINEVA collection add-to-cart]', err); throw err; })
    .finally(function() { if (btn) btn.classList.remove('is-adding'); });
  }

  /* ─── BUY NOW (shared) — same one-variant /cart/add.js POST as
     addVariantToCart above, then straight to checkout instead of opening
     the drawer. Same shape as the PDP's own jnGilBuyNow. Only used by the
     quick-add sheet's own BUY NOW button below — collection cards have no
     single-variant buy-now path today (add-to-cart already covers that
     fast path), so this doesn't touch anything that worked before it
     existed. ── */
  function buyVariantNow(variantId, btn) {
    if (btn) btn.classList.add('is-adding');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function(r) { if (!r.ok) throw new Error(r.statusText); return r.json(); })
    .then(function() { window.location.href = '/checkout'; })
    .catch(function(err) {
      console.error('[JIINEVA collection buy-now]', err);
      if (btn) btn.classList.remove('is-adding');
    });
  }

  /* ─── QUICK-ADD SIZE SHEET — fetches the clicked product's real variant
     list on demand via Shopify's own documented, unauthenticated
     /products/{handle}.js endpoint, so collection cards never carry full
     variant JSON server-side. Only
     fetched at all when data-variant-count > 1 — a plain accessory with one
     variant still adds instantly with zero extra request, exactly as
     before. ── */
  var qaOverlay = document.getElementById('jnc-qa-overlay');
  var qaSheet   = document.getElementById('jnc-qa-sheet');
  var qaTitle   = document.getElementById('jnc-qa-title');
  var qaClose   = document.getElementById('jnc-qa-close');
  var qaImg     = document.getElementById('jnc-qa-img');
  var qaName    = document.getElementById('jnc-qa-name');
  var qaColor   = document.getElementById('jnc-qa-color');
  var qaPrice   = document.getElementById('jnc-qa-price');
  var qaOptions = document.getElementById('jnc-qa-options');
  var qaNudge   = document.getElementById('jnc-qa-nudge');
  var qaAddBtn  = document.getElementById('jnc-qa-add-btn');
  var qaBuyBtn  = document.getElementById('jnc-qa-buy-btn');

  /* ─── MEASUREMENT GUIDE PANEL ──────────────────────────────────────
     Mirrors the PDP's openDetailOverlay/closeDetailOverlay pair.

     WHICH guide a product gets is decided by the COLLECTIONS it is in on
     Shopify, never by its name or Type. The header renders the four
     guides, each tagged with the collection handles it serves (its
     "Collections using the ... guide" setting), and this walks them
     looking for an overlap with the product's own collections, which the
     card publishes as data-collections.

     Returns null when nothing matches, and the SIZE GUIDE link is then
     not rendered at all. That is deliberate: a product in an unmapped
     collection shows NO guide rather than a half-matched wrong one.
     Mapping a new collection is a Customize edit in the header, no code. -- */
  function jncMeasureSourceFor(productCollections) {
    var mine = (productCollections || '').toLowerCase().split(',');
    var i, j;
    for (i = 0; i < mine.length; i++) { mine[i] = mine[i].replace(/^\s+|\s+$/g, ''); }
    /* Walks whatever guides the header rendered, in order, rather than a
       hardcoded list of the four we happen to have today. That is what
       makes adding a whole new category — mangalsutra with its own
       measurements, say — a change to jn-header.liquid ONLY: add the
       setting and its div there and this picks it up with no edit to this
       file, the home page or the product page. */
    var guides = document.querySelectorAll('.jn-measure-src');
    for (i = 0; i < guides.length; i++) {
      var el = guides[i];
      /* A guide with no text written yet never matches, so an empty one
         hides the link instead of opening a blank panel. */
      if (!el.textContent.replace(/^\s+|\s+$/g, '')) continue;
      var serves = (el.getAttribute('data-collections') || '').toLowerCase().split(',');
      for (j = 0; j < serves.length; j++) {
        var h = serves[j].replace(/^\s+|\s+$/g, '');
        if (h && mine.indexOf(h) !== -1) return el;
      }
    }
    return null;
  }


  var jncDetailBg    = document.getElementById('jnc-detail-overlay-bg');
  var jncDetailPanel = document.getElementById('jnc-detail-overlay-panel');
  var jncDetailTitle = document.getElementById('jnc-detail-overlay-title');
  var jncDetailBody  = document.getElementById('jnc-detail-overlay-body');
  var jncDetailClose = document.getElementById('jnc-detail-overlay-close');

  function jncOpenDetailOverlay(title, html) {
    if (!jncDetailPanel) return;
    if (jncDetailTitle) jncDetailTitle.textContent = title || '';
    if (jncDetailBody)  jncDetailBody.innerHTML = html || '';
    if (jncDetailBg)    jncDetailBg.classList.add('jnp-open');
    jncDetailPanel.classList.add('jnp-open');
    jncDetailPanel.setAttribute('aria-hidden', 'false');
    /* Opens ON TOP of the size sheet rather than replacing it — the sheet
       stays on the overlay stack underneath, so closing this returns the
       shopper to their half-finished size pick, back button included. */
    jnLockBodyScroll();
    jnpPushOverlay('measure');
  }
  window.jncCloseDetailOverlay = function() {
    if (!jncDetailPanel) return;
    if (jncDetailBg) jncDetailBg.classList.remove('jnp-open');
    jncDetailPanel.classList.remove('jnp-open');
    jncDetailPanel.setAttribute('aria-hidden', 'true');
    jnpMaybeUnlockScroll();
  };
  if (jncDetailClose) jncDetailClose.addEventListener('click', function() { jnpManualClose('measure'); });
  if (jncDetailBg)    jncDetailBg.addEventListener('click', function() { jnpManualClose('measure'); });

  window.jnpOpenQaSheet = function() {
    if (!qaSheet) return;
    qaSheet.classList.add('jnp-open');
    if (qaOverlay) qaOverlay.classList.add('jnp-open');
    /* FIX: was a bare document.body.style.overflow = 'hidden', out of sync
       with the drawer this sheet hands off into (which locks via the
       shared jnLockBodyScroll() further down this file — position:fixed +
       a data-jn-scroll-locked marker, not just overflow). Using the same
       shared lock here means jnpMaybeUnlockScroll (also further down) can
       correctly tell whether this sheet is part of why scroll is locked.
       See the STUCK SCROLL fix note next to jnpAnyOverlayOpen below. */
    jnLockBodyScroll();
  };
  window.jnpCloseQaSheet = function() {
    if (!qaSheet) return;
    qaSheet.classList.remove('jnp-open');
    if (qaOverlay) qaOverlay.classList.remove('jnp-open');
    /* FIX: this used to unconditionally clear document.body.style.overflow,
       which — when a size pick here hands straight off into the cart
       drawer opening on top (see the "Progressing to the drawer" comment
       below) — clobbered the overflow:hidden half of the drawer's OWN,
       still-active jnLockBodyScroll() lock a moment after it was set,
       while leaving that lock's position:fixed/top untouched. Body was
       left pinned (position:fixed) with scrolling dead until a hard
       refresh, even though the drawer was still legitimately open.
       jnpMaybeUnlockScroll (defined with the history-based overlay
       management further down this file) only actually unlocks once
       nothing — drawer included — is still open. */
    jnpMaybeUnlockScroll();
  };
  /* Explicit dismiss (X / overlay click / back button) — consumes its own
     history entry immediately via jnpManualClose, same as the drawer's own
     close controls. */
  if (qaClose)   qaClose.addEventListener('click', function() { jnpManualClose('qasheet'); });
  if (qaOverlay) qaOverlay.addEventListener('click', function() { jnpManualClose('qasheet'); });

  var jncQaSeq = 0;
  function openSizePicker(card, handle, triggerBtn) {
    var qaToken = ++jncQaSeq;
    /* Drop the previous product's handlers until this product's options load. */
    if (qaAddBtn) qaAddBtn.onclick = null;
    if (qaBuyBtn) qaBuyBtn.onclick = null;
    var nameEl  = card ? card.querySelector('.jn-product-name')  : null;
    var priceEl = card ? card.querySelector('.jn-product-price') : null;
    var imgEl   = card ? card.querySelector('.jn-product-img-main') : null;
    /* Colour, if this product has one, was already picked on the card
       itself via the COLOR SWATCH PREVIEW handler further below (defaults
       to the first colour, same as the PDP defaults to
       product.selected_or_first_available_variant) — read whichever
       swatch currently carries .jn-swatch-active so this sheet only ever
       has to ask about what's still genuinely unresolved, same as PDP. */
    var activeSwatch     = card ? card.querySelector('.jn-color-swatch.jn-swatch-active') : null;
    var activeColorValue = activeSwatch ? activeSwatch.getAttribute('title') : null;
    /* Which collections this product is in — the card publishes them as
       data-collections. This is what the SIZE GUIDE trigger resolves
       against; the product's name and Type are never consulted. */
    var cardCollections  = card ? (card.getAttribute('data-collections') || '') : '';

    if (qaName)  qaName.textContent  = nameEl  ? nameEl.textContent  : '';
    if (qaColor) {
      /* Colour is resolved silently via the card's own active swatch before
         this sheet ever opens (see the comment above) — shown here so the
         shopper can actually see which colour they're about to pick a size
         for, instead of it being invisible once the sheet only asks about
         Size. Hidden entirely for products with no colour to resolve. */
      qaColor.textContent = activeColorValue || '';
      qaColor.hidden = !activeColorValue;
    }
    if (qaPrice) qaPrice.textContent = priceEl ? priceEl.textContent : '';
    if (qaImg)   { qaImg.src = imgEl ? imgEl.src : ''; qaImg.alt = qaName ? qaName.textContent : ''; }
    if (qaTitle) qaTitle.textContent = 'SELECT SIZE';
    if (qaNudge) qaNudge.hidden = true;
    if (qaOptions) qaOptions.innerHTML = '<div class="jnc-qa-empty">LOADING…</div>';
    window.jnpOpenQaSheet();
    jnpPushOverlay('qasheet');

    fetch('/products/' + handle + '.js', { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(product) {
        if (qaToken !== jncQaSeq) return;
        var allVariants = (product && product.variants) || [];
        var options     = (product && product.options) || [];
        if (!qaOptions) return;
        if (!allVariants.length) {
          qaOptions.innerHTML = '<div class="jnc-qa-empty">NO OPTIONS AVAILABLE</div>';
          return;
        }

        /* Narrow to the already-picked colour's own variants first — a
           product with no Colour option, or a card with no active swatch
           for some reason, keeps every variant unfiltered, identical to
           today's behaviour. */
        var colorOpt = options.filter(function(o) { return o.name === 'Color' || o.name === 'Colour'; })[0];
        var filteredVariants = allVariants;
        if (colorOpt && activeColorValue) {
          var colorKey = 'option' + colorOpt.position;
          var byColor = allVariants.filter(function(v) { return v[colorKey] === activeColorValue; });
          if (byColor.length) filteredVariants = byColor;
        }

        /* Whatever's left to ask about — every option with more than one
           value, minus Colour once it's resolved above. In practice this
           is just Size: one option group, same as the PDP would show once
           colour is picked. */
        var remaining = options.filter(function(o) {
          if (!o.values || o.values.length <= 1) return false;
          if (colorOpt && o.position === colorOpt.position && activeColorValue) return false;
          return true;
        });

        if (!remaining.length) {
          /* Nothing left to choose — colour (if any) came from the card's
             own swatch and every other option only has one value. Skip
             the sheet and add straight away, same as a genuinely
             single-variant product always has. */
          if (window.jnpManualClose) window.jnpManualClose('qasheet');
          else window.jnpCloseQaSheet();
          addVariantToCart(String(filteredVariants[0].id), triggerBtn);
          return;
        }

        if (qaTitle) {
          qaTitle.textContent = 'SELECT ' + remaining.map(function(o) { return o.name; }).join(' & ').toUpperCase();
        }

        var selections = {};
        function resolveVariant() {
          for (var i = 0; i < remaining.length; i++) {
            if (!(('option' + remaining[i].position) in selections)) return null;
          }
          return filteredVariants.filter(function(v) {
            return remaining.every(function(o) {
              var k = 'option' + o.position;
              return v[k] === selections[k];
            });
          })[0] || null;
        }
        function showMissingNudge() {
          if (!qaNudge) return;
          var missing = remaining.filter(function(o) { return !(('option' + o.position) in selections); });
          var names = (missing.length ? missing : remaining).map(function(o) { return o.name; });
          qaNudge.textContent = 'Please select ' + names.join(', ');
          qaNudge.hidden = false;
        }

        qaOptions.innerHTML = '';
        remaining.forEach(function(opt, optIdx) {
          var key = 'option' + opt.position;
          var group = document.createElement('div');
          group.className = 'jnc-qa-option-group';
          var row = document.createElement('div');
          row.className = 'jnc-qa-option-row';
          var rowLabel = document.createElement('span');
          rowLabel.className = 'jnc-qa-option-row-label';
          rowLabel.textContent = (opt.name || '').toUpperCase();
          row.appendChild(rowLabel);
          /* SIZE GUIDE sits opposite the first non-colour option's label —
             the same placement the PDP gives its SEE MEASUREMENTS button,
             and the same rule for which row gets it (colour is already
             resolved before this sheet opens, so remaining[0] IS the first
             non-colour option). Rendered only when there is actually a
             guide for this product's category, so a product type with no
             guide written yet shows nothing rather than opening an empty
             panel. */
          if (optIdx === 0) {
            var guideEl = jncMeasureSourceFor(cardCollections);
            if (guideEl) {
              var guideBtn = document.createElement('button');
              guideBtn.type = 'button';
              guideBtn.className = 'jnc-qa-measure-btn';
              guideBtn.textContent = 'SIZE GUIDE';
              guideBtn.addEventListener('click', function() {
                jncOpenDetailOverlay('SEE MEASUREMENTS', guideEl.innerHTML);
              });
              row.appendChild(guideBtn);
            }
          }
          var grid = document.createElement('div');
          grid.className = 'jnc-qa-option-btn-grid';
          group.appendChild(row);
          group.appendChild(grid);
          opt.values.forEach(function(val) {
            var match = filteredVariants.filter(function(v) { return v[key] === val; })[0];
            if (!match) return;
            var optBtn = document.createElement('button');
            optBtn.type = 'button';
            optBtn.className = 'jnc-qa-option-btn' + (match.available ? '' : ' is-oos');
            optBtn.textContent = val;
            optBtn.setAttribute('data-variant-id', match.id);
            if (!match.available) optBtn.disabled = true;
            optBtn.addEventListener('click', function() {
              if (!match.available) return;
              grid.querySelectorAll('.jnc-qa-option-btn').forEach(function(b) { b.classList.remove('is-active'); });
              optBtn.classList.add('is-active');
              selections[key] = val;
              if (qaNudge) qaNudge.hidden = true;
              /* ─── Size pick → refresh the quick-add sheet's price to this
                 variant's own price. Shopify /products/{handle}.js returns
                 variant.price in PAISE (same as /cart.js, verified against live
                 API), so divide by 100 before formatting. Compare price is
                 shown struck-through alongside when it's higher. ── */
              if (qaPrice) {
                var inr = function(n) { return '₹' + Math.floor(n / 100).toLocaleString('en-IN'); };
                var picked = resolveVariant() || match;
                var txt = inr(picked.price);
                if (picked.compare_at_price && picked.compare_at_price > picked.price) {
                  txt = '<span style="text-decoration:line-through;color:#999;margin-right:8px;">' + inr(picked.compare_at_price) + '</span>' + txt;
                  qaPrice.innerHTML = txt;
                } else {
                  qaPrice.textContent = txt;
                }
              }
            });
            grid.appendChild(optBtn);
          });
          qaOptions.appendChild(group);
        });

        /* ADD TO CART / BUY NOW — plain reassignment (not addEventListener)
           since these two buttons live in the static sheet shell and are
           reused across every open; addEventListener here would stack a
           new listener, and a new variant, on top of the last one every
           time this sheet opens. The dynamically-built pills above don't
           need this — qaOptions.innerHTML='' above already discards them
           (and their listeners) between opens. */
        if (qaAddBtn) {
          qaAddBtn.onclick = function() {
            var variant = resolveVariant();
            if (!variant) { showMissingNudge(); return; }
            /* Close the qa-sheet via the overlay stack BEFORE adding (see the
               authoritative comment in jiineva-product.liquid). Leaving 'qasheet'
               on the stack while the drawer opens on top stacks two entries;
               closing the drawer later only pops its own entry and
               jnpMaybeUnlockScroll keeps the body locked because 'qasheet' is
               still there — which is exactly the page-stuck-after-drawer-close
               bug. jnpManualClose pops stack + history cleanly. */
            if (window.jnpManualClose) window.jnpManualClose('qasheet');
            else window.jnpCloseQaSheet();
            addVariantToCart(String(variant.id), qaAddBtn).catch(function() {});
          };
        }
        if (qaBuyBtn) {
          qaBuyBtn.onclick = function() {
            var variant = resolveVariant();
            if (!variant) { showMissingNudge(); return; }
            buyVariantNow(String(variant.id), qaBuyBtn);
          };
        }
      })
      .catch(function(err) {
        console.error('[JIINEVA quick-add fetch]', err);
        if (qaOptions) qaOptions.innerHTML = '<div class="jnc-qa-empty">SOMETHING WENT WRONG</div>';
      });
  }

  /* ─── ADD TO CART / QUICK-ADD trigger — single-variant products add
     directly (unchanged fast path, zero extra request); multi-variant
     products open the size sheet above instead of guessing a size for the
     shopper, matching Comet's own collection-page + button. ── */
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-cart-add]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    var variantId    = btn.getAttribute('data-variant-id');
    var variantCount = parseInt(btn.getAttribute('data-variant-count'), 10) || 1;
    var handle       = btn.getAttribute('data-handle');
    if (!variantId) return;

    if (variantCount > 1 && handle) {
      openSizePicker(btn.closest('.jn-product-card'), handle, btn);
      return;
    }
    addVariantToCart(variantId, btn);
  });

  /* ─── COLOR SWATCH PREVIEW — clicking a colour box swaps this card's main
     image to that colour's representative image and moves the active ring
     (matches what Ana Luisa's own collection page actually does on click,
     confirmed by testing it live). openSizePicker above now also reads
     whichever swatch carries .jn-swatch-active, so picking a colour here
     narrows the quick-add sheet to that colour's own sizes too — this
     handler itself still only ever touches the image/active-ring, the
     actual reading happens entirely on the size-picker's side, so this
     stays a one-way dependency and can't regress by itself. Delegated +
     preventDefault/stopPropagation for the same reason as [data-cart-add]:
     these buttons sit inside the card's <a class="jn-product-link">. ── */
  document.addEventListener('click', function(e) {
    var sw = e.target.closest('.jn-color-swatch');
    if (!sw) return;
    e.preventDefault();
    e.stopPropagation();
    var card = sw.closest('.jn-product-card');
    if (!card) return;
    var img = card.querySelector('.jn-product-img-main');
    var newSrc = sw.getAttribute('data-swatch-image');
    if (img && newSrc) {
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      img.src = newSrc;
    }
    var swatches = card.querySelectorAll('.jn-color-swatch');
    for (var i = 0; i < swatches.length; i++) { swatches[i].classList.remove('jn-swatch-active'); }
    sw.classList.add('jn-swatch-active');

    /* ─── PRICE REFRESH FOR THIS COLOUR — each swatch carries its own
       colour's LOWEST variant price (data-price / data-compare-price, in
       paise; set server-side in the swatch loop). A colour swap is
       effectively a different product for the shopper, so the headline
       price swaps with it: silver's lowest ≠ gold's lowest in general.
       Compare price + discount badge auto-hide when compare ≤ price.
       Format: INR with commas and NO decimals. ── */
    try {
      var price = parseInt(sw.getAttribute('data-price'), 10);
      var compare = parseInt(sw.getAttribute('data-compare-price'), 10) || 0;
      if (!isNaN(price) && price > 0) {
        var priceEl = card.querySelector('.jn-product-price');
        var compareEl = card.querySelector('.jn-product-compare-price');
        var discountEl = card.querySelector('.jn-product-discount-badge');
        var inr = function(p) { return '₹' + Math.floor(p / 100).toLocaleString('en-IN'); };
        if (priceEl) priceEl.textContent = inr(price);
        if (compare > price) {
          if (compareEl) { compareEl.textContent = inr(compare); compareEl.hidden = false; }
          if (discountEl) {
            var pct = Math.round(((compare - price) / compare) * 100);
            discountEl.textContent = pct + '% OFF';
            discountEl.hidden = false;
          }
        } else {
          if (compareEl) compareEl.hidden = true;
          if (discountEl) discountEl.hidden = true;
        }
      }
      /* Keep the +button's data-variant-id on the colour's own lowest variant
         so a tap on + opens the sheet already narrowed to that colour. */
      var vid = sw.getAttribute('data-variant-id');
      if (vid) {
        var addBtn = card.querySelector('[data-cart-add]');
        if (addBtn) addBtn.setAttribute('data-variant-id', vid);
      }
    } catch (err) { /* defensive — colour swap must never throw */ }
  });

  /* ─── CART DRAWER + OFFERS PANEL — base implementation (render, quantity
     stepper, offers panel open/close/copy) moved to jn-header.liquid, shared by
     every page instead of duplicated here. ── */

  /* ─── MULTI-BADGE ROTATOR — exposed on window so any future
     client-side-injected cards (filter re-render, infinite scroll) can
     wire fresh rotators as they appear. data-rotator-wired dedupes. ── */
  window.jnpBadgeRotatorRun = function(root) {
    (root || document).querySelectorAll('.jnp-corner-badge-rotator').forEach(function(host) {
      if (host.getAttribute('data-rotator-wired') === '1') return;
      var labels = host.querySelectorAll('.jnp-corner-badge-label');
      if (labels.length < 2) { host.setAttribute('data-rotator-wired', '1'); return; }
      host.setAttribute('data-rotator-wired', '1');
      var interval = parseInt(host.getAttribute('data-rotate-interval'), 10) || 4000;
      var idx = 0;
      setInterval(function() {
        labels[idx].setAttribute('hidden', '');
        idx = (idx + 1) % labels.length;
        labels[idx].removeAttribute('hidden');
      }, interval);
    });
  };
  window.jnpBadgeRotatorRun();

})();

/* ─── DRAWER — ported verbatim from jiineva-product.liquid (Part A3):
   window.jnpOpenDrawer / window.jnpCloseDrawer, the hover/touch auto-close
   timers, the outside-click-closes listener, and the full history-based
   overlay system (jnpPushOverlay, jnpCloseOverlayByName, jnpManualClose,
   the popstate listener, and the _baseOpenDrawer history-pushing wrapper).
   jnpCloseOverlayByName is simplified to only the 'drawer' case, since this
   page isn't gaining the detail/seel/lightbox overlays product.liquid has —
   same function name/shape kept for consistency, per the founder's spec. ── */
(function() {
  'use strict';

  /* ─── CART DRAWER base (open/close, outside-click, nav bag-icon handler)
     moved to jn-header.liquid, shared by every page. drawerPanel/drawerOverlay
     stay here — jnpCloseOverlayByName's 'drawer' case below still directly
     toggles their classList, same as before. ── */
  var drawerPanel   = document.getElementById('jnp-drawer-panel');
  var drawerOverlay = document.getElementById('jnp-drawer-overlay');

  /* ─── HISTORY-BASED BACK BUTTON OVERLAY MANAGEMENT ─── */
  var jnpOverlayStack = [];
  var jnpIsClosingManually = false;

  /* ═══ STUCK SCROLL FIX ═══════════════════════════════════════════════
     Reported live: after opening the bag drawer (e.g. quick-add from a
     collection card) and closing it, the page sometimes could no longer
     be scrolled at all — clicks still worked, only a hard refresh fixed
     it. Root cause: opening the drawer/offers panel/quick-add sheet locks
     scroll via the shared jnLockBodyScroll() in jn-header.liquid, which
     sets position:fixed + top + a data-jn-scroll-locked marker on <body>
     (not just overflow — that's the more robust, mobile-safe lock this
     site already uses everywhere else). But closing them here only ever
     reset document.body.style.overflow directly, leaving position:fixed
     (and the marker) stuck forever — confirmed live: opened the drawer,
     closed it via the × button, and body stayed position:fixed with
     scrolling dead. jnpAnyOverlayOpen checks each overlay's actual
     jnp-open class rather than jnpOverlayStack's length, because the
     stack can legitimately still hold an already-closed entry (see the
     quick-add sheet's "Progressing to the drawer" comment below, where
     'qasheet' deliberately stays on the stack after the sheet itself is
     dismissed) — checking real DOM state avoids ever getting that wrong
     in either direction. Only jiineva-collection.liquid's own drawer/
     offers/quick-add-sheet close paths needed this — jiineva-product.liquid
     already does the equivalent (jnpMaybeUnlockScroll there, same idea)
     for every overlay it has. ═══════════════════════════════════════ */
  function jnpAnyOverlayOpen() {
    var qaSheetEl = document.getElementById('jnc-qa-sheet');
    var offersPanelEl = document.getElementById('jnp-offers-panel');
    /* Measurement guide counts too — it can sit open on top of the size
       sheet, and without it here closing the sheet underneath would
       release the scroll lock while the guide was still covering the
       screen. */
    var measurePanelEl = document.getElementById('jnc-detail-overlay-panel');
    /* The filter panel counts too, but only below 768px — that is the only
       width where it is a full-screen takeover that locks scroll. On
       desktop the very same .is-open class means "the sidebar is showing",
       an ordinary layout state that must never hold the page's scroll
       hostage. */
    var filterLayoutEl = document.getElementById('jnc-layout');
    var filterIsOverlay = !!(filterLayoutEl &&
                             filterLayoutEl.classList.contains('is-open') &&
                             window.matchMedia('(max-width: 767px)').matches);
    return (drawerPanel && drawerPanel.classList.contains('jnp-open')) ||
           (qaSheetEl && qaSheetEl.classList.contains('jnp-open')) ||
           (measurePanelEl && measurePanelEl.classList.contains('jnp-open')) ||
           filterIsOverlay ||
           (offersPanelEl && offersPanelEl.classList.contains('jnp-open'));
  }
  function jnpMaybeUnlockScroll() {
    if (!jnpAnyOverlayOpen()) jnUnlockBodyScroll();
  }
  window.jnpMaybeUnlockScroll = jnpMaybeUnlockScroll;

  function jnpPushOverlay(name) {
    jnpOverlayStack.push(name);
    history.pushState({ jnpOverlay: name, depth: jnpOverlayStack.length }, '');
  }
  window.jnpPushOverlay = jnpPushOverlay;

  function jnpCloseOverlayByName(name) {
    if (name === 'drawer') {
      if (drawerPanel) {
        drawerPanel.classList.remove('jnp-open');
        drawerPanel.setAttribute('aria-hidden', 'true');
      }
      if (drawerOverlay) drawerOverlay.classList.remove('jnp-open');
      jnpMaybeUnlockScroll();
    } else if (name === 'qasheet') {
      if (window.jnpCloseQaSheet) window.jnpCloseQaSheet();
    } else if (name === 'measure') {
      if (window.jncCloseDetailOverlay) window.jncCloseDetailOverlay();
    } else if (name === 'offers') {
      if (window.jnpCloseOffersPanel) window.jnpCloseOffersPanel();
      jnpMaybeUnlockScroll();
    } else if (name === 'filter') {
      /* Back gesture on a phone with the filter panel up: close the panel,
         stay on the collection. */
      if (window.jncCloseFilterPanel) window.jncCloseFilterPanel();
      jnpMaybeUnlockScroll();
    }
  }

  /* ─── CTA IDLE-STATE SWEEP — back button / bfcache safety net ───
     A card's quick-add icon/+ button (.is-adding while its fetch is in
     flight) can be left visually "mid-click" two ways: BUY NOW navigates
     straight to /checkout and, if the browser restores this exact page
     from its back-forward cache on a later back-button press, nothing here
     re-runs to clear it — pageshow below catches that. ADD TO CART instead
     opens the cart drawer via history.pushState (jnpPushOverlay); an
     instant back-button tap can pop that entry (closing the drawer via the
     popstate handler right below) before the button's own .finally() gets
     a chance to run — calling this at the very top of that same handler
     catches that case too. Harmless no-op when there's nothing to reset. */
  function jnResetAllCtaStates() {
    document.querySelectorAll('.is-adding').forEach(function(el) { el.classList.remove('is-adding'); });
  }
  window.jnResetAllCtaStates = jnResetAllCtaStates;
  window.addEventListener('pageshow', function(e) {
    if (e.persisted) { jnResetAllCtaStates(); }
  });

  window.addEventListener('popstate', function(e) {
    jnResetAllCtaStates();
    if (jnpIsClosingManually) {
      jnpIsClosingManually = false;
      return;
    }
    if (jnpOverlayStack.length > 0) {
      var name = jnpOverlayStack.pop();
      jnpCloseOverlayByName(name);
    }
  });

  function jnpManualClose(name) {
    var idx = jnpOverlayStack.lastIndexOf(name);
    if (idx !== -1) {
      jnpOverlayStack.splice(idx, 1);
      jnpIsClosingManually = true;
      jnpCloseOverlayByName(name);
      history.back();
    } else {
      jnpCloseOverlayByName(name);
    }
  }
  window.jnpManualClose = jnpManualClose;

  var _baseOpenDrawer = window.jnpOpenDrawer;
  window.jnpOpenDrawer = function() {
    _baseOpenDrawer();
    jnpPushOverlay('drawer');
  };
})();

/* ─── CROSS-SELL: TRUE INFINITE LOOP (mobile) + no-shrink scroll (desktop) ───
   Verified live against bluorng.com: the active card sits centered with a
   peeking neighbor on BOTH sides at every position — including the first and
   last real tile — and every swipe, including the wrap, animates identically
   with no visible jump. Achieved by cloning the first tile and appending it
   after the last, cloning the last tile and prepending it before the first —
   so a neighbor always exists to peek from and slide toward in both
   directions. Once a wrap-transition finishes, the track snaps invisibly
   (no transition) to the matching REAL tile's position — pixel-identical to
   the clone just shown, so the reset is never visible. ── */
(function() {
  var track = document.getElementById('jnc-crosssell-track');
  if (!track) return;
  var realTiles = Array.prototype.slice.call(track.querySelectorAll('.jnc-crosssell-tile'));
  if (realTiles.length < 2) { realTiles.forEach(function(t) { t.classList.add('jnc-cs-active'); }); return; }

  function isMobile() { return window.innerWidth < 768; }

  /* Two clones per side, not one. A single clone fixes the ACTIVE tile at
     the wrap point, but that tile's own peek neighbor — the sliver of the
     next tile visible at the screen edge — had nothing real to show there,
     so the instant reset made that peek pop in a frame late and read as a
     jerk. A second clone behind the first gives the wrap position the same
     left+right peek content as the real position it snaps to, so the whole
     frame matches before and after the reset, not just the centered tile. */
  var cloneLastA  = realTiles[realTiles.length - 1].cloneNode(true); /* mimics last real tile */
  var cloneLastB  = realTiles[realTiles.length - 2].cloneNode(true); /* mimics 2nd-to-last, peeks behind cloneLastA */
  var cloneFirstA = realTiles[0].cloneNode(true);                    /* mimics first real tile */
  var cloneFirstB = realTiles[1].cloneNode(true);                    /* mimics 2nd real tile, peeks behind cloneFirstA */
  [cloneLastA, cloneLastB, cloneFirstA, cloneFirstB].forEach(function(c) { c.setAttribute('aria-hidden', 'true'); c.setAttribute('tabindex', '-1'); });
  track.insertBefore(cloneLastA, track.firstChild);
  track.insertBefore(cloneLastB, track.firstChild);
  track.appendChild(cloneFirstA);
  track.appendChild(cloneFirstB);

  var allTiles = Array.prototype.slice.call(track.children);
  var total    = allTiles.length;
  var current  = 2; /* index 2 = first REAL tile; indices 0-1 = the two lead-in clones */

  /* Position comes straight from the browser's own rendered layout via
     offsetLeft — the same technique the testimonials carousel below
     already uses successfully — instead of multiplying the swipe index
     by an estimated tile width. offsetLeft always reflects each tile's
     true position, including its share of the flex gap, so there's no
     separate width number to keep in sync and no rounding drift to
     build up across tiles or surface at the wrap reset. */
  var isAnimating   = false;
  var animLockTimer = null;
  function goTo(idx, instant) {
    if (!isMobile()) return;
    current = Math.max(0, Math.min(total - 1, idx));
    track.style.transition = instant ? 'none' : '';
    track.style.transform = 'translateX(-' + allTiles[current].offsetLeft + 'px)';
    if (instant) {
      track.getBoundingClientRect();
      track.style.transition = '';
    } else {
      isAnimating = true;
      clearTimeout(animLockTimer);
      animLockTimer = setTimeout(function() { isAnimating = false; }, 200);
    }
    /* Active + immediate-neighbour classes. Only the two tiles directly
       beside the active one tilt (jnc-cs-left / jnc-cs-right). Tiles
       further out keep the plain scale+dim without rotation, which is
       exactly how bluorng's own carousel reads — the far tiles don't
       compound more and more tilt, they just dim and shrink flat. */
    allTiles.forEach(function(t, i) {
      t.classList.toggle('jnc-cs-active', i === current);
      t.classList.toggle('jnc-cs-left',  i === current - 1);
      t.classList.toggle('jnc-cs-right', i === current + 1);
    });
  }
  track.addEventListener('transitionend', function(e) {
    if (e.target !== track || e.propertyName !== 'transform') return;
    isAnimating = false;
    clearTimeout(animLockTimer);
    if (!isMobile()) return;
    if (current === total - 2) { goTo(2, true); }
    else if (current === 1) { goTo(total - 3, true); }
  });
  window.addEventListener('resize', function() {
    if (!isMobile()) { track.style.transform = ''; }
    else { goTo(current, true); }
  });
  var touchStartX = 0;
  var touchMoved  = false;
  track.addEventListener('touchstart', function(e) {
    touchStartX = e.touches[0].clientX;
    touchMoved  = false;
  }, { passive: true });
  track.addEventListener('touchmove', function() { touchMoved = true; }, { passive: true });
  track.addEventListener('touchend', function(e) {
    if (!touchMoved) return;
    if (isAnimating) return;
    var dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1), false);
  }, { passive: true });
  goTo(2, true);

  /* Desktop arrow controls removed — the track is a native horizontal
     scroller now (click-drag + trackpad + touchpad + scrollbar). When
     the row has ≤ 4 tiles there is no overflow to scroll in the first
     place; when it has 5 or 6, the CSS above narrows each tile so the
     5th peeks in as a swipe cue. */
})();

/* ─── TESTIMONIALS CAROUSEL — rebuilt from a second live look at
   wearcomet.com, this time via its own Swiper instance + computed
   styles. Under 750px: one full-width card per view, exactly like
   Comet's base config (slidesPerView 1). From 750px up: the next card
   peeks in (Comet runs slidesPerView 1.1 with a 30-38px gap) — this
   build advances by each card's actual offsetLeft rather than a flat
   100% multiplier, so the same math is correct whether the card is
   full-width (mobile) or peeking (tablet/desktop). Advanced by touch
   swipe or the arrow buttons, both driving the same transform. Clamped,
   non-looping — arrows disable at both ends, exactly like Comet's own
   swiper-button-disabled at slide 1 and 5 of 5. ── */
(function() {
  var track = document.getElementById('jnc-testimonials-track');
  if (!track) return;
  var cards = Array.prototype.slice.call(track.querySelectorAll('.jnc-testimonial-card'));
  if (!cards.length) return;

  var prevBtn = document.getElementById('jnc-testi-prev');
  var nextBtn = document.getElementById('jnc-testi-next');
  var current = 0;

  function updateArrows() {
    if (prevBtn) prevBtn.disabled = current === 0;
    if (nextBtn) nextBtn.disabled = current === cards.length - 1;
  }

  function goTo(idx, instant) {
    current = Math.max(0, Math.min(cards.length - 1, idx));
    track.style.transition = instant ? 'none' : '';
    track.style.transform = 'translateX(-' + cards[current].offsetLeft + 'px)';
    if (instant) { track.getBoundingClientRect(); track.style.transition = ''; }
    updateArrows();
  }

  if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1, false); });
  if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1, false); });

  var touchStartX = 0;
  var touchMoved  = false;
  track.addEventListener('touchstart', function(e) {
    touchStartX = e.touches[0].clientX;
    touchMoved  = false;
  }, { passive: true });
  track.addEventListener('touchmove', function() { touchMoved = true; }, { passive: true });
  track.addEventListener('touchend', function(e) {
    if (!touchMoved) return;
    var dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1), false);
  }, { passive: true });

  window.addEventListener('resize', function() { goTo(current, true); });

  goTo(0, true);
})();

</script>

