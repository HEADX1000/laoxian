      <span class="jnc-detail-overlay-title" id="jnc-detail-overlay-title">SEE MEASUREMENTS</span>
      <button class="jnc-detail-overlay-close" id="jnc-detail-overlay-close" aria-label="Close">&#215;</button>
    </div>
